<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchoolManagement.Client.Maui.ViewModels"
             xmlns:models="clr-namespace:SchoolManagement.Application.Common.Models;assembly=SchoolManagement.Application"
             x:Class="SchoolManagement.Client.Maui.Views.StaffPage"
             x:DataType="vm:StaffViewModel"
             BackgroundColor="{StaticResource DarkBase}"
             Title="{Binding Title}">

    <Grid>
        <!-- Main Content -->
        <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="18">
            <!-- Header Toolbar -->
            <Border Grid.Row="0"
                    BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="20,14">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Text="&#x2190; Dashboard"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="{StaticResource DarkElevated}"
                            TextColor="{StaticResource White}"
                            FontSize="12"
                            HeightRequest="36"
                            Padding="14,0"
                            CornerRadius="6" />

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Staff &amp; Teacher Management"
                               TextColor="{StaticResource White}"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label Text="Onboard educators, manage qualifications, track departments, and configure system access."
                               TextColor="{StaticResource Gray400}"
                               FontSize="12" />
                    </VerticalStackLayout>

                    <!-- Staff Count Pill -->
                    <Border Grid.Column="2"
                            BackgroundColor="{StaticResource DarkElevated}"
                            Stroke="{StaticResource DarkBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="14,6">
                        <Label Text="{Binding TotalStaffCount, StringFormat='{0} Staff'}"
                               TextColor="{StaticResource PrimaryLight}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>

                    <!-- Onboard Staff Button -->
                    <Button Grid.Column="3"
                            Text="+ Onboard Staff"
                            Command="{Binding OpenOnboardModalCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="38"
                            Padding="18,0"
                            CornerRadius="8" />
                </Grid>
            </Border>

            <!-- Search Bar -->
            <Border Grid.Row="1"
                    BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource DarkElevated}"
                            Stroke="{StaticResource DarkBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,0"
                            HeightRequest="42">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="&#x1F50D;"
                                   TextColor="{StaticResource Gray400}"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0" />
                            <Entry Grid.Column="1"
                                   Placeholder="Search by name, employee code, department, or email"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Text="{Binding SearchText}"
                                   TextColor="{StaticResource White}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   ClearButtonVisibility="WhileEditing" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Text="Search"
                            Command="{Binding SearchStaffCommand}"
                            BackgroundColor="{StaticResource DarkElevated}"
                            TextColor="{StaticResource White}"
                            FontSize="13"
                            HeightRequest="42"
                            Padding="16,0"
                            CornerRadius="8" />

                    <Button Grid.Column="2"
                            Text="Refresh"
                            Command="{Binding LoadStaffCommand}"
                            BackgroundColor="{StaticResource DarkElevated}"
                            TextColor="{StaticResource PrimaryLight}"
                            FontSize="13"
                            HeightRequest="42"
                            Padding="16,0"
                            CornerRadius="8" />
                </Grid>
            </Border>

            <!-- Status & Error Banners -->
            <VerticalStackLayout Grid.Row="1" Margin="0,58,0,0" Spacing="6">
                <Border BackgroundColor="#1E3A2F"
                        Stroke="#2ECC71"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="14,8"
                        IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}">
                    <Label Text="{Binding StatusMessage}" TextColor="#2ECC71" FontSize="13" />
                </Border>

                <Border BackgroundColor="#3A1E1E"
                        Stroke="#E74C3C"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="14,8"
                        IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="#E74C3C" FontSize="13" />
                </Border>
            </VerticalStackLayout>

            <!-- Staff List -->
            <Border Grid.Row="2"
                    BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <CollectionView ItemsSource="{Binding StaffList}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="8"
                                             Padding="40">
                            <Label Text="&#x1F468;&#x200D;&#x1F3EB;" FontSize="40" HorizontalOptions="Center" />
                            <Label Text="No staff members found"
                                   TextColor="{StaticResource White}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <Label Text="Use the '+ Onboard Staff' button to add teachers and school personnel."
                                   TextColor="{StaticResource Gray400}"
                                   FontSize="13"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:StaffSummaryDto">
                            <Border BackgroundColor="{StaticResource DarkElevated}"
                                    Stroke="{StaticResource DarkBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="16,14"
                                    Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                    <!-- Employee Code Badge -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="{StaticResource DarkBase}"
                                            Stroke="{StaticResource Secondary}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="12,8"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding EmployeeCode}"
                                               TextColor="{StaticResource Secondary}"
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <!-- Staff Information -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding FullName}"
                                                   TextColor="{StaticResource White}"
                                                   FontSize="15"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Designation, StringFormat='({0})'}"
                                                   TextColor="{StaticResource PrimaryLight}"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="16">
                                            <Label Text="{Binding Department, StringFormat='Dept: {0}'}"
                                                   TextColor="{StaticResource Gray400}"
                                                   FontSize="12" />
                                            <Label Text="{Binding Email}"
                                                   TextColor="{StaticResource Gray400}"
                                                   FontSize="12" />
                                            <Label Text="{Binding EmploymentType, StringFormat='Type: {0}'}"
                                                   TextColor="{StaticResource Gray400}"
                                                   FontSize="12" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="2"
                                            BackgroundColor="#1E3A2F"
                                            Stroke="#2ECC71"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="10,4"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Status}"
                                               TextColor="#2ECC71"
                                               FontSize="11"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <!-- Actions -->
                                    <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                                        <Button Text="Profile"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StaffViewModel}}, Path=ViewStaffDetailsCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource DarkBase}"
                                                TextColor="{StaticResource White}"
                                                FontSize="12"
                                                HeightRequest="34"
                                                Padding="12,0"
                                                CornerRadius="6" />

                                        <Button Text="Toggle Status"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StaffViewModel}}, Path=ToggleStatusCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource DarkElevated}"
                                                TextColor="{StaticResource PrimaryLight}"
                                                FontSize="12"
                                                HeightRequest="34"
                                                Padding="10,0"
                                                CornerRadius="6" />

                                        <Button Text="Delete"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StaffViewModel}}, Path=DeleteStaffCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#3A1E1E"
                                                TextColor="#E74C3C"
                                                FontSize="12"
                                                HeightRequest="34"
                                                Padding="12,0"
                                                CornerRadius="6" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>

        <!-- Onboard Staff Modal Overlay -->
        <Grid BackgroundColor="#CC000000"
              IsVisible="{Binding IsOnboardModalVisible}"
              Padding="40">
            <Border BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    MaximumWidthRequest="640"
                    VerticalOptions="Center"
                    Padding="24">
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Onboard Staff &amp; Faculty"
                                       TextColor="{StaticResource White}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Text="Create staff profile and generate system user credentials."
                                       TextColor="{StaticResource Gray400}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="&#x2715;"
                                    Command="{Binding CloseOnboardModalCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource White}"
                                    FontSize="16" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource DarkBorder}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                            <!-- First Name -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <Label Text="First Name *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewFirstName}" Placeholder="e.g. Fatima" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Last Name -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                <Label Text="Last Name *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewLastName}" Placeholder="e.g. Noor" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Email -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Label Text="Email Address *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewEmail}" Placeholder="e.g. fatima@school.edu" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Phone -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Label Text="Phone Number" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewPhoneNumber}" Placeholder="e.g. +92 311 1234567" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Designation -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                                <Label Text="Designation *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewDesignation}" Placeholder="e.g. Science Teacher" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Department -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                <Label Text="Department *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewDepartment}" Placeholder="e.g. Science &amp; Math" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Qualification -->
                            <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="4">
                                <Label Text="Qualification" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewQualification}" Placeholder="e.g. M.Sc. Physics" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Basic Salary -->
                            <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="4">
                                <Label Text="Basic Salary (PKR)" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewBasicSalary}" Placeholder="e.g. 75000" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Error Message inside Modal -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#E74C3C"
                               FontSize="12"
                               IsVisible="{Binding HasError}" />

                        <!-- Action Buttons -->
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="12" Margin="0,10,0,0">
                            <Button Text="Cancel"
                                    Command="{Binding CloseOnboardModalCommand}"
                                    BackgroundColor="{StaticResource DarkElevated}"
                                    TextColor="{StaticResource White}"
                                    FontSize="13"
                                    HeightRequest="40"
                                    Padding="16,0"
                                    CornerRadius="8" />

                            <Button Text="Submit Onboarding"
                                    Command="{Binding SubmitOnboardCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource White}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    HeightRequest="40"
                                    Padding="20,0"
                                    CornerRadius="8" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Staff Profile Details Modal -->
        <Grid BackgroundColor="#CC000000"
              IsVisible="{Binding IsDetailsModalVisible}"
              Padding="40">
            <Border BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    MaximumWidthRequest="560"
                    VerticalOptions="Center"
                    Padding="24">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding CurrentStaffDetails.FullName}"
                                   TextColor="{StaticResource White}"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding CurrentStaffDetails.EmployeeCode, StringFormat='Employee Code: {0}'}"
                                   TextColor="{StaticResource Secondary}"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="&#x2715;"
                                Command="{Binding CloseDetailsModalCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource White}"
                                FontSize="16" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource DarkBorder}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding CurrentStaffDetails.Designation, StringFormat='Designation: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CurrentStaffDetails.Department, StringFormat='Department: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding CurrentStaffDetails.Email, StringFormat='Email: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentStaffDetails.PhoneNumber, StringFormat='Phone: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding CurrentStaffDetails.EmploymentType, StringFormat='Type: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding CurrentStaffDetails.Status, StringFormat='Status: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="3" Grid.Column="0" Text="{Binding CurrentStaffDetails.Qualification, StringFormat='Qualification: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding CurrentStaffDetails.BasicSalary, StringFormat='Basic Salary: PKR {0:N0}'}" TextColor="{StaticResource White}" FontSize="13" />
                    </Grid>

                    <Button Text="Close Profile"
                            Command="{Binding CloseDetailsModalCommand}"
                            BackgroundColor="{StaticResource DarkElevated}"
                            TextColor="{StaticResource White}"
                            FontSize="13"
                            HeightRequest="38"
                            CornerRadius="8"
                            HorizontalOptions="End"
                            Padding="20,0"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
