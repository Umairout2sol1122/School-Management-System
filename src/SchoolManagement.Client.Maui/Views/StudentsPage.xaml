<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SchoolManagement.Client.Maui.ViewModels"
             xmlns:models="clr-namespace:SchoolManagement.Application.Common.Models;assembly=SchoolManagement.Application"
             x:Class="SchoolManagement.Client.Maui.Views.StudentsPage"
             x:DataType="vm:StudentsViewModel"
             BackgroundColor="{StaticResource DarkBase}"
             Title="{Binding Title}">

    <Grid>
        <!-- Main Content -->
        <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="18">
            <!-- Header Toolbar -->
            <Border Grid.Row="0"
                    BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="20,14">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Text="&#x2190; Dashboard"
                            Command="{Binding GoBackCommand}"
                            BackgroundColor="{StaticResource DarkElevated}"
                            TextColor="{StaticResource White}"
                            FontSize="12"
                            HeightRequest="36"
                            Padding="14,0"
                            CornerRadius="6" />

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Student Directory &amp; Admissions"
                               TextColor="{StaticResource White}"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label Text="Manage student enrollment, class allocations, guardian linkages, and student profiles."
                               TextColor="{StaticResource Gray400}"
                               FontSize="12" />
                    </VerticalStackLayout>

                    <!-- Student Count Pill -->
                    <Border Grid.Column="2"
                            BackgroundColor="{StaticResource DarkElevated}"
                            Stroke="{StaticResource DarkBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="14,6">
                        <Label Text="{Binding TotalStudentsCount, StringFormat='{0} Enrolled'}"
                               TextColor="{StaticResource PrimaryLight}"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>

                    <!-- Admit Student Button -->
                    <Button Grid.Column="3"
                            Text="+ Admit Student"
                            Command="{Binding OpenAdmitModalCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="38"
                            Padding="18,0"
                            CornerRadius="8" />
                </Grid>
            </Border>

            <!-- Search & Filter Bar -->
            <Border Grid.Row="1"
                    BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            BackgroundColor="{StaticResource DarkElevated}"
                            Stroke="{StaticResource DarkBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,0"
                            HeightRequest="42">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Text="&#x1F50D;"
                                   TextColor="{StaticResource Gray400}"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0" />
                            <Entry Grid.Column="1"
                                   Placeholder="Search by student name, admission #, or roll #"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Text="{Binding SearchText}"
                                   TextColor="{StaticResource White}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   ClearButtonVisibility="WhileEditing" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Text="Search"
                            Command="{Binding SearchStudentsCommand}"
                            BackgroundColor="{StaticResource DarkElevated}"
                            TextColor="{StaticResource White}"
                            FontSize="13"
                            HeightRequest="42"
                            Padding="16,0"
                            CornerRadius="8" />

                    <Button Grid.Column="2"
                            Text="Refresh"
                            Command="{Binding LoadStudentsCommand}"
                            BackgroundColor="{StaticResource DarkElevated}"
                            TextColor="{StaticResource PrimaryLight}"
                            FontSize="13"
                            HeightRequest="42"
                            Padding="16,0"
                            CornerRadius="8" />
                </Grid>
            </Border>

            <!-- Status & Error Banners -->
            <VerticalStackLayout Grid.Row="1" Margin="0,58,0,0" Spacing="6">
                <Border BackgroundColor="#1E3A2F"
                        Stroke="#2ECC71"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="14,8"
                        IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}">
                    <Label Text="{Binding StatusMessage}" TextColor="#2ECC71" FontSize="13" />
                </Border>

                <Border BackgroundColor="#3A1E1E"
                        Stroke="#E74C3C"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="14,8"
                        IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="#E74C3C" FontSize="13" />
                </Border>
            </VerticalStackLayout>

            <!-- Students List -->
            <Border Grid.Row="2"
                    BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="16">
                <Grid>
                    <!-- Empty State -->
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="12"
                                         IsVisible="{Binding Students.Count, Converter={StaticResource BoolToStatusBgConverter}}">
                        <!-- Re-using visible when empty check -->
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding Students}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="8"
                                                 Padding="40">
                                <Label Text="&#x1F393;" FontSize="40" HorizontalOptions="Center" />
                                <Label Text="No students found"
                                       TextColor="{StaticResource White}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                                <Label Text="Use the '+ Admit Student' button to enroll students into this school."
                                       TextColor="{StaticResource Gray400}"
                                       FontSize="13"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:StudentSummaryDto">
                                <Border BackgroundColor="{StaticResource DarkElevated}"
                                        Stroke="{StaticResource DarkBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="16,14"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" VerticalOptions="Center">
                                        <!-- Admission Badge -->
                                        <Border Grid.Column="0"
                                                BackgroundColor="{StaticResource DarkBase}"
                                                Stroke="{StaticResource PrimaryLight}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="12,8"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding AdmissionNumber}"
                                                   TextColor="{StaticResource PrimaryLight}"
                                                   FontSize="12"
                                                   FontAttributes="Bold" />
                                        </Border>

                                        <!-- Student & Guardian Information -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding FullName}"
                                                       TextColor="{StaticResource White}"
                                                       FontSize="15"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding CurrentGrade, StringFormat='({0})'}"
                                                       TextColor="{StaticResource Secondary}"
                                                       FontSize="13"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="16">
                                                <Label Text="{Binding PrimaryGuardianName, StringFormat='Parent: {0}'}"
                                                       TextColor="{StaticResource Gray400}"
                                                       FontSize="12"
                                                       IsVisible="{Binding PrimaryGuardianName, Converter={StaticResource StringNotEmptyConverter}}" />
                                                <Label Text="{Binding PrimaryGuardianPhone, StringFormat='Ph: {0}'}"
                                                       TextColor="{StaticResource Gray400}"
                                                       FontSize="12"
                                                       IsVisible="{Binding PrimaryGuardianPhone, Converter={StaticResource StringNotEmptyConverter}}" />
                                                <Label Text="{Binding BranchName, StringFormat='Campus: {0}'}"
                                                       TextColor="{StaticResource Gray400}"
                                                       FontSize="12"
                                                       IsVisible="{Binding BranchName, Converter={StaticResource StringNotEmptyConverter}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="2"
                                                BackgroundColor="#1E3A2F"
                                                Stroke="#2ECC71"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="10,4"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Status}"
                                                   TextColor="#2ECC71"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />
                                        </Border>

                                        <!-- Action Buttons -->
                                        <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                                            <Button Text="Profile"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentsViewModel}}, Path=ViewStudentDetailsCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource DarkBase}"
                                                    TextColor="{StaticResource White}"
                                                    FontSize="12"
                                                    HeightRequest="34"
                                                    Padding="12,0"
                                                    CornerRadius="6" />

                                            <Button Text="Delete"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentsViewModel}}, Path=DeleteStudentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#3A1E1E"
                                                    TextColor="#E74C3C"
                                                    FontSize="12"
                                                    HeightRequest="34"
                                                    Padding="12,0"
                                                    CornerRadius="6" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <!-- Admission Modal Overlay -->
        <Grid BackgroundColor="#CC000000"
              IsVisible="{Binding IsAdmitModalVisible}"
              Padding="40">
            <Border BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    MaximumWidthRequest="680"
                    VerticalOptions="Center"
                    Padding="24">
                <ScrollView>
                    <VerticalStackLayout Spacing="16">
                        <!-- Modal Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Student Admission &amp; Enrollment"
                                       TextColor="{StaticResource White}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Text="Enroll a student and atomically link parent/guardian contact info."
                                       TextColor="{StaticResource Gray400}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="&#x2715;"
                                    Command="{Binding CloseAdmitModalCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource White}"
                                    FontSize="16"
                                    HeightRequest="32"
                                    WidthRequest="32" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource DarkBorder}" />

                        <!-- Section: Student Details -->
                        <Label Text="1. STUDENT INFORMATION"
                               TextColor="{StaticResource PrimaryLight}"
                               FontSize="12"
                               FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <!-- First Name -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <Label Text="First Name *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewFirstName}" Placeholder="e.g. Ali" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Last Name -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                <Label Text="Last Name *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewLastName}" Placeholder="e.g. Khan" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Grade / Class -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Label Text="Grade / Class *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewGrade}" Placeholder="e.g. Grade 5" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Section -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Label Text="Section" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewSection}" Placeholder="e.g. A" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Roll Number -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                                <Label Text="Roll Number" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewRollNumber}" Placeholder="e.g. R-105" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- B-Form / CNIC -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                <Label Text="B-Form / National ID" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewNationalId}" Placeholder="e.g. 61101-1234567-1" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource DarkBorder}" />

                        <!-- Section: Guardian Details -->
                        <Label Text="2. PARENT / GUARDIAN INFORMATION"
                               TextColor="{StaticResource Secondary}"
                               FontSize="12"
                               FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <!-- Guardian First Name -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <Label Text="Guardian First Name *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewGuardianFirstName}" Placeholder="e.g. Tariq" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Guardian Last Name -->
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                <Label Text="Guardian Last Name *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewGuardianLastName}" Placeholder="e.g. Khan" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Guardian Phone -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Label Text="Phone Number *" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewGuardianPhone}" Placeholder="e.g. +92 300 1234567" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Guardian Email -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Label Text="Email Address" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewGuardianEmail}" Placeholder="e.g. parent@gmail.com" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Occupation -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                                <Label Text="Occupation" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewGuardianOccupation}" Placeholder="e.g. Engineer" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>

                            <!-- Address -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                <Label Text="Residential Address" TextColor="{StaticResource Gray400}" FontSize="12" />
                                <Entry Text="{Binding NewAddress}" Placeholder="e.g. Street 5, G-10/2" TextColor="{StaticResource White}" BackgroundColor="{StaticResource DarkElevated}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Error Message inside Modal -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#E74C3C"
                               FontSize="12"
                               IsVisible="{Binding HasError}" />

                        <!-- Action Buttons -->
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="12" Margin="0,10,0,0">
                            <Button Text="Cancel"
                                    Command="{Binding CloseAdmitModalCommand}"
                                    BackgroundColor="{StaticResource DarkElevated}"
                                    TextColor="{StaticResource White}"
                                    FontSize="13"
                                    HeightRequest="40"
                                    Padding="16,0"
                                    CornerRadius="8" />

                            <Button Text="Submit Admission"
                                    Command="{Binding SubmitAdmissionCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource White}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    HeightRequest="40"
                                    Padding="20,0"
                                    CornerRadius="8" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Student Profile Details Modal Overlay -->
        <Grid BackgroundColor="#CC000000"
              IsVisible="{Binding IsDetailsModalVisible}"
              Padding="40">
            <Border BackgroundColor="{StaticResource DarkCard}"
                    Stroke="{StaticResource DarkBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    MaximumWidthRequest="600"
                    VerticalOptions="Center"
                    Padding="24">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding CurrentStudentDetails.FullName}"
                                   TextColor="{StaticResource White}"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding CurrentStudentDetails.AdmissionNumber, StringFormat='Admission ID: {0}'}"
                                   TextColor="{StaticResource PrimaryLight}"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="&#x2715;"
                                Command="{Binding CloseDetailsModalCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource White}"
                                FontSize="16" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource DarkBorder}" />

                    <!-- Key Attributes Grid -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding CurrentStudentDetails.CurrentGrade, StringFormat='Grade: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CurrentStudentDetails.Section, StringFormat='Section: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding CurrentStudentDetails.Gender, StringFormat='Gender: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentStudentDetails.BloodGroup, StringFormat='Blood Group: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding CurrentStudentDetails.City, StringFormat='City: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding CurrentStudentDetails.BranchName, StringFormat='Campus: {0}'}" TextColor="{StaticResource White}" FontSize="13" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource DarkBorder}" />

                    <!-- Linked Guardians / Sibling Connections -->
                    <Label Text="Linked Guardians &amp; Emergency Contacts"
                           TextColor="{StaticResource Secondary}"
                           FontSize="14"
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding CurrentStudentDetails.Guardians}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:StudentGuardianDto">
                                <Border BackgroundColor="{StaticResource DarkElevated}"
                                        Stroke="{StaticResource DarkBorder}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12,8"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Spacing="2">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding FullName}" TextColor="{StaticResource White}" FontSize="13" FontAttributes="Bold" />
                                                <Label Text="{Binding Relationship, StringFormat='({0})'}" TextColor="{StaticResource PrimaryLight}" FontSize="12" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Phone, StringFormat='Ph: {0}'}" TextColor="{StaticResource Gray400}" FontSize="12" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                BackgroundColor="#1E3A2F"
                                                Stroke="#2ECC71"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="8,2"
                                                IsVisible="{Binding IsPrimaryContact}">
                                            <Label Text="Primary" TextColor="#2ECC71" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Close Profile"
                            Command="{Binding CloseDetailsModalCommand}"
                            BackgroundColor="{StaticResource DarkElevated}"
                            TextColor="{StaticResource White}"
                            FontSize="13"
                            HeightRequest="38"
                            CornerRadius="8"
                            HorizontalOptions="End"
                            Padding="20,0"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
