<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SchoolManagement.Client.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SchoolManagement.Client.Maui.Views"
    FlyoutBehavior="Disabled"
    Title="School Management Platform">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Dashboard"
        ContentTemplate="{DataTemplate views:DashboardPage}"
        Route="DashboardPage" />

    <ShellContent
        Title="Organizations"
        ContentTemplate="{DataTemplate views:OrganizationsPage}"
        Route="OrganizationsPage" />

    <ShellContent
        Title="School Profile"
        ContentTemplate="{DataTemplate views:SchoolProfilePage}"
        Route="SchoolProfilePage" />

    <ShellContent
        Title="Students"
        ContentTemplate="{DataTemplate views:StudentsPage}"
        Route="StudentsPage" />

    <ShellContent
        Title="Staff"
        ContentTemplate="{DataTemplate views:StaffPage}"
        Route="StaffPage" />

</Shell>
