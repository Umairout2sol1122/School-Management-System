@{
    ViewData["Title"] = "Daily Student Attendance";
}

<!-- Page Header & Action Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-calendar-check-fill text-primary"></i>
            <span>Daily Attendance &amp; Roll Call</span>
        </h1>
        <p class="text-secondary small mb-0">Record daily classroom check-ins, manage leave excuses, and trigger automated absence SMS notifications.</p>
    </div>
    <div class="d-flex gap-2">
        <ul class="nav nav-pills" id="attendanceTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active btn-sm" id="tab-daily-btn" data-bs-toggle="pill" data-bs-target="#tab-daily" type="button" role="tab">
                    <i class="bi bi-calendar-day me-1"></i> Daily Roll Call
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link btn-sm" id="tab-monthly-btn" data-bs-toggle="pill" data-bs-target="#tab-monthly" type="button" role="tab" onclick="loadMonthlyRegister()">
                    <i class="bi bi-bar-chart-steps me-1"></i> Monthly Register &amp; Defaulters
                </button>
            </li>
        </ul>
    </div>
</div>

<div class="tab-content" id="attendanceTabContent">
    <!-- TAB 1: DAILY ROLL CALL -->
    <div class="tab-pane fade show active" id="tab-daily" role="tabpanel">
        <!-- Class & Date Selection Filter Bar -->
        <div class="card p-3 p-md-4 shadow-sm border-0 mb-4" style="background: var(--saas-surface);">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label text-secondary small fw-semibold">Attendance Date</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-calendar3"></i></span>
                        <input type="date" class="form-control border-start-0" id="attDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")">
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-secondary small fw-semibold">Grade / Class <span class="text-danger">*</span></label>
                    <select class="form-select" id="selGrade" onchange="onGradeSelected()">
                        <option value="">-- Choose Class --</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-secondary small fw-semibold">Section</label>
                    <select class="form-select" id="selSection">
                        <option value="">-- All Sections --</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button type="button" class="btn btn-saas-primary w-100" id="btnLoadStudents" onclick="loadStudentsForRollCall()">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="loadSpinner"></span>
                        <i class="bi bi-search me-1" id="loadIcon"></i> Load Roll Call
                    </button>
                </div>
            </div>
        </div>

        <!-- Attendance KPI Summary Stats -->
        <div class="row g-3 mb-4 d-none" id="kpiRow">
            <div class="col-6 col-md-2">
                <div class="card p-3 shadow-sm border-0 text-center">
                    <div class="small text-secondary fw-semibold">Total Students</div>
                    <div class="fs-3 fw-bold text-body" id="kpiTotal">0</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card p-3 shadow-sm border-0 text-center" style="background: rgba(16, 185, 129, 0.08); border-left: 3px solid #10B981 !important;">
                    <div class="small text-success fw-semibold">Present [P]</div>
                    <div class="fs-3 fw-bold text-success" id="kpiPresent">0</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card p-3 shadow-sm border-0 text-center" style="background: rgba(239, 68, 68, 0.08); border-left: 3px solid #EF4444 !important;">
                    <div class="small text-danger fw-semibold">Absent [A]</div>
                    <div class="fs-3 fw-bold text-danger" id="kpiAbsent">0</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card p-3 shadow-sm border-0 text-center" style="background: rgba(245, 158, 11, 0.08); border-left: 3px solid #F59E0B !important;">
                    <div class="small text-warning fw-semibold">Late [L]</div>
                    <div class="fs-3 fw-bold text-warning" id="kpiLate">0</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card p-3 shadow-sm border-0 text-center" style="background: rgba(59, 130, 246, 0.08); border-left: 3px solid #3B82F6 !important;">
                    <div class="small text-primary fw-semibold">Excused [E]</div>
                    <div class="fs-3 fw-bold text-primary" id="kpiExcused">0</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="card p-3 shadow-sm border-0 text-center">
                    <div class="small text-secondary fw-semibold">Attendance Rate</div>
                    <div class="fs-3 fw-bold text-body" id="kpiRate">0%</div>
                </div>
            </div>
        </div>

        <!-- Student Roll Call Table -->
        <div class="card shadow-sm border-0 mb-4" id="rollCallCard" style="display: none;">
            <div class="card-header bg-transparent py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <div>
                    <h5 class="fw-bold mb-0" id="cardClassTitle">Student Roll Call</h5>
                    <div class="small text-secondary" id="cardClassSubtitle">Select status for each student. Absent students trigger parent SMS notifications.</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="markAllStatus(1)">
                        <i class="bi bi-check-all me-1"></i> Mark All Present
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="markAllStatus(2)">
                        <i class="bi bi-x-circle me-1"></i> Mark All Absent
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0" id="tblRollCall">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;">Roll No</th>
                            <th>Student Information</th>
                            <th style="min-width: 280px;">Attendance Status</th>
                            <th>Remarks / Note</th>
                        </tr>
                    </thead>
                    <tbody id="rollCallTableBody">
                    </tbody>
                </table>
            </div>

            <!-- Submit Action Footer -->
            <div class="card-footer bg-transparent py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="chkLockAttendance">
                    <label class="form-check-label fw-semibold small" for="chkLockAttendance">Lock attendance after submission (prevents edits without admin unlock)</label>
                </div>
                <button type="button" class="btn btn-saas-primary px-4 py-2" id="btnSubmitAttendance" onclick="submitAttendance()">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="submitSpinner"></span>
                    <i class="bi bi-cloud-arrow-up-fill me-1" id="submitIcon"></i> Submit Attendance Record
                </button>
            </div>
        </div>

        <!-- Initial Placeholder State -->
        <div class="card p-5 text-center border-0 shadow-sm" id="emptyState">
            <div class="text-secondary mb-3">
                <i class="bi bi-person-lines-fill" style="font-size: 3.5rem; color: var(--saas-primary);"></i>
            </div>
            <h4 class="fw-bold">Class Attendance Roster</h4>
            <p class="text-secondary small mx-auto" style="max-width: 480px;">
                Select a class and section from the controls above and click <strong>"Load Roll Call"</strong> to mark today's attendance.
            </p>
        </div>
    </div>

    <!-- TAB 2: MONTHLY REGISTER & DEFAULTERS -->
    <div class="tab-pane fade" id="tab-monthly" role="tabpanel">
        <div class="card p-3 p-md-4 shadow-sm border-0 mb-4" style="background: var(--saas-surface);">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label text-secondary small fw-semibold">Year</label>
                    <select class="form-select" id="selMonthlyYear">
                        <option value="2026" selected>2026</option>
                        <option value="2025">2025</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-secondary small fw-semibold">Month</label>
                    <select class="form-select" id="selMonthlyMonth">
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10" selected>October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-secondary small fw-semibold">Class / Grade</label>
                    <select class="form-select" id="selMonthlyGrade">
                        <option value="">-- All Classes --</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button type="button" class="btn btn-saas-primary w-100" onclick="loadMonthlyRegister()">
                        <i class="bi bi-funnel me-1"></i> View Register &amp; Defaulters
                    </button>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Monthly Student Attendance Summary</h5>
                <span class="badge bg-warning text-dark" id="lblDefaulterCount">0 Defaulters (&lt; 75%)</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0" id="tblMonthly">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Roll No</th>
                            <th>Student Name</th>
                            <th>Class / Section</th>
                            <th>Present</th>
                            <th>Absent</th>
                            <th>Late</th>
                            <th>Excused</th>
                            <th>Total Days</th>
                            <th>Attendance %</th>
                            <th class="text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody id="monthlyTableBody">
                        <tr>
                            <td colspan="10" class="text-center py-5 text-secondary">
                                <i class="bi bi-calendar2-range fs-1 d-block mb-2"></i>
                                Select filters above and click "View Register" to generate report.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let gradesList = [];
    let studentsInClass = [];
    let attendanceRecordsMap = {};

    document.addEventListener("DOMContentLoaded", async () => {
        // Set current month in monthly tab
        const curMonth = new Date().getMonth() + 1;
        const curYear = new Date().getFullYear();
        document.getElementById("selMonthlyMonth").value = curMonth;
        document.getElementById("selMonthlyYear").value = curYear;

        await loadGrades();
    });

    async function loadGrades() {
        const res = await App.apiFetch("/api/academics/classes");
        if (res.ok && res.data && res.data.success) {
            gradesList = res.data.data;
            populateGradeDropdowns();
        } else {
            // Fallback to grades endpoint
            const res2 = await App.apiFetch("/api/academics/grades");
            if (res2.ok && res2.data && res2.data.success) {
                gradesList = res2.data.data;
                populateGradeDropdowns();
            }
        }
    }

    function populateGradeDropdowns() {
        const selGrade = document.getElementById("selGrade");
        const selMonthlyGrade = document.getElementById("selMonthlyGrade");

        selGrade.innerHTML = '<option value="">-- Choose Class --</option>';
        selMonthlyGrade.innerHTML = '<option value="">-- All Classes --</option>';

        gradesList.forEach(g => {
            const opt = `<option value="${g.id}">${g.name} (${g.code || ''})</option>`;
            selGrade.innerHTML += opt;
            selMonthlyGrade.innerHTML += opt;
        });

        // Auto-select first class if available for quick workflow
        if (gradesList.length > 0) {
            selGrade.value = gradesList[0].id;
            onGradeSelected();
        }
    }

    function onGradeSelected() {
        const gradeId = document.getElementById("selGrade").value;
        const selSection = document.getElementById("selSection");
        selSection.innerHTML = '<option value="">-- All Sections --</option>';

        if (!gradeId) return;

        const grade = gradesList.find(g => g.id === gradeId);
        if (grade && grade.sections && Array.isArray(grade.sections)) {
            grade.sections.forEach(s => {
                selSection.innerHTML += `<option value="${s.id}">${s.name}</option>`;
            });
        }
    }

    async function loadStudentsForRollCall() {
        const gradeId = document.getElementById("selGrade").value;
        const sectionId = document.getElementById("selSection").value;
        const date = document.getElementById("attDate").value;

        if (!gradeId) {
            App.showToast('warning', 'Class Required', 'Please select a Class / Grade to load student roster.');
            return;
        }

        const spin = document.getElementById("loadSpinner");
        const icon = document.getElementById("loadIcon");
        const btn = document.getElementById("btnLoadStudents");

        btn.disabled = true;
        spin.classList.remove("d-none");
        icon.classList.add("d-none");

        // 1. Fetch Students enrolled in this grade/section
        let studentUrl = `/api/students?currentGradeId=${gradeId}&pageSize=100`;
        if (sectionId) studentUrl += `&sectionId=${sectionId}`;

        const studentRes = await App.apiFetch(studentUrl);

        // 2. Fetch existing attendance records for this date and grade
        let attUrl = `/api/attendance?date=${date}&classGradeId=${gradeId}`;
        if (sectionId) attUrl += `&classSectionId=${sectionId}`;

        const attRes = await App.apiFetch(attUrl);

        btn.disabled = false;
        spin.classList.add("d-none");
        icon.classList.remove("d-none");

        if (studentRes.ok && studentRes.data && studentRes.data.success) {
            studentsInClass = studentRes.data.data.items || studentRes.data.data || [];
            
            // Map existing attendance
            attendanceRecordsMap = {};
            if (attRes.ok && attRes.data && attRes.data.success) {
                const summary = attRes.data.data;
                const recs = summary.records || [];
                recs.forEach(r => {
                    attendanceRecordsMap[r.studentId] = {
                        status: r.status,
                        remarks: r.remarks || '',
                        isLocked: r.isLocked
                    };
                });
            }

            renderRollCallTable();
        } else {
            App.showToast('error', 'Error', 'Failed to load students for the selected class.');
        }
    }

    function renderRollCallTable() {
        const tbody = document.getElementById("rollCallTableBody");
        const empty = document.getElementById("emptyState");
        const card = document.getElementById("rollCallCard");
        const kpiRow = document.getElementById("kpiRow");

        if (studentsInClass.length === 0) {
            empty.style.display = "block";
            card.style.display = "none";
            kpiRow.classList.add("d-none");
            tbody.innerHTML = "";
            empty.innerHTML = `
                <div class="text-secondary mb-3"><i class="bi bi-inbox fs-1"></i></div>
                <h5 class="fw-bold">No Students Enrolled</h5>
                <p class="text-secondary small">There are currently no active students found in the selected class/section.</p>
            `;
            return;
        }

        empty.style.display = "none";
        card.style.display = "block";
        kpiRow.classList.remove("d-none");

        const selGradeEl = document.getElementById("selGrade");
        const gradeName = selGradeEl.options[selGradeEl.selectedIndex]?.text || 'Class';
        const date = document.getElementById("attDate").value;

        document.getElementById("cardClassTitle").textContent = `${gradeName} — Daily Roll Call`;
        document.getElementById("cardClassSubtitle").textContent = `Roster for ${new Date(date).toDateString()} (${studentsInClass.length} Students)`;

        tbody.innerHTML = studentsInClass.map((s, index) => {
            const existing = attendanceRecordsMap[s.id] || { status: 1, remarks: '' };
            const statusVal = existing.status;

            return `
            <tr id="row-${s.id}">
                <td class="ps-4 fw-bold font-monospace text-secondary">
                    ${s.rollNumber || (index + 1)}
                </td>
                <td>
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 36px; height: 36px; background: var(--saas-primary-gradient); font-size: 0.85rem;">
                            ${(s.firstName || 'S').substring(0, 1).toUpperCase()}
                        </div>
                        <div>
                            <div class="fw-bold text-body">${s.fullName || (s.firstName + ' ' + s.lastName)}</div>
                            <div class="small text-secondary">Adm: ${s.admissionNumber || '-'} • Sec: ${s.section || 'Default'}</div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="btn-group w-100" role="group" aria-label="Attendance Status">
                        <input type="radio" class="btn-check" name="status-${s.id}" id="p-${s.id}" value="1" ${statusVal === 1 ? 'checked' : ''} onchange="updateKPIs()">
                        <label class="btn btn-sm btn-outline-success fw-semibold" for="p-${s.id}">
                            <i class="bi bi-check-circle me-1"></i> Present
                        </label>

                        <input type="radio" class="btn-check" name="status-${s.id}" id="a-${s.id}" value="2" ${statusVal === 2 ? 'checked' : ''} onchange="updateKPIs()">
                        <label class="btn btn-sm btn-outline-danger fw-semibold" for="a-${s.id}">
                            <i class="bi bi-x-circle me-1"></i> Absent
                        </label>

                        <input type="radio" class="btn-check" name="status-${s.id}" id="l-${s.id}" value="3" ${statusVal === 3 ? 'checked' : ''} onchange="updateKPIs()">
                        <label class="btn btn-sm btn-outline-warning fw-semibold" for="l-${s.id}">
                            <i class="bi bi-clock me-1"></i> Late
                        </label>

                        <input type="radio" class="btn-check" name="status-${s.id}" id="e-${s.id}" value="4" ${statusVal === 4 ? 'checked' : ''} onchange="updateKPIs()">
                        <label class="btn btn-sm btn-outline-primary fw-semibold" for="e-${s.id}">
                            <i class="bi bi-shield-check me-1"></i> Excused
                        </label>
                    </div>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm" id="rem-${s.id}" placeholder="Optional reason / notes..." value="${existing.remarks || ''}">
                </td>
            </tr>
            `;
        }).join("");

        updateKPIs();
    }

    function markAllStatus(statusVal) {
        studentsInClass.forEach(s => {
            const rad = document.querySelector(`input[name="status-${s.id}"][value="${statusVal}"]`);
            if (rad) rad.checked = true;
        });
        updateKPIs();
    }

    function updateKPIs() {
        let total = studentsInClass.length;
        let present = 0;
        let absent = 0;
        let late = 0;
        let excused = 0;

        studentsInClass.forEach(s => {
            const checked = document.querySelector(`input[name="status-${s.id}"]:checked`);
            if (checked) {
                const val = parseInt(checked.value);
                if (val === 1) present++;
                else if (val === 2) absent++;
                else if (val === 3) late++;
                else if (val === 4) excused++;
            }
        });

        const rate = total > 0 ? Math.round(((present + late) / total) * 100) : 0;

        document.getElementById("kpiTotal").textContent = total;
        document.getElementById("kpiPresent").textContent = present;
        document.getElementById("kpiAbsent").textContent = absent;
        document.getElementById("kpiLate").textContent = late;
        document.getElementById("kpiExcused").textContent = excused;
        document.getElementById("kpiRate").textContent = `${rate}%`;
    }

    async function submitAttendance() {
        const gradeId = document.getElementById("selGrade").value;
        const sectionId = document.getElementById("selSection").value;
        const date = document.getElementById("attDate").value;
        const lock = document.getElementById("chkLockAttendance").checked;

        if (!gradeId || studentsInClass.length === 0) {
            App.showToast('warning', 'No Students', 'No student records to submit.');
            return;
        }

        const entries = [];
        let absentCount = 0;

        studentsInClass.forEach(s => {
            const checked = document.querySelector(`input[name="status-${s.id}"]:checked`);
            const status = checked ? parseInt(checked.value) : 1;
            const remarks = document.getElementById(`rem-${s.id}`)?.value?.trim() || '';

            if (status === 2) absentCount++;

            entries.push({
                studentId: s.id,
                status: status,
                remarks: remarks
            });
        });

        let confirmMsg = `Submit attendance for ${entries.length} students on ${date}?`;
        if (absentCount > 0) {
            confirmMsg += ` Automated absence alerts will be sent for ${absentCount} absent student(s).`;
        }

        const conf = await Swal.fire({
            title: 'Confirm Attendance Submission',
            text: confirmMsg,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#924EC0',
            confirmButtonText: 'Yes, Submit Attendance'
        });

        if (!conf.isConfirmed) return;

        const btn = document.getElementById("btnSubmitAttendance");
        const spin = document.getElementById("submitSpinner");
        const icon = document.getElementById("submitIcon");

        btn.disabled = true;
        spin.classList.remove("d-none");
        icon.classList.add("d-none");

        const payload = {
            classGradeId: gradeId,
            classSectionId: sectionId ? sectionId : null,
            date: date,
            lockImmediately: lock,
            entries: entries
        };

        const res = await App.apiFetch("/api/attendance/bulk", {
            method: "POST",
            body: JSON.stringify(payload)
        });

        btn.disabled = false;
        spin.classList.add("d-none");
        icon.classList.remove("d-none");

        if (res.ok && res.data && res.data.success) {
            Swal.fire({
                icon: 'success',
                title: 'Attendance Saved!',
                text: `Successfully recorded attendance for ${entries.length} students.`,
                confirmButtonColor: '#924EC0'
            });
            loadStudentsForRollCall();
        } else {
            App.showToast('error', 'Submission Failed', res.data?.message || 'Unable to record attendance.');
        }
    }

    // --- TAB 2: MONTHLY REGISTER & DEFAULTERS ---
    async function loadMonthlyRegister() {
        const year = document.getElementById("selMonthlyYear").value;
        const month = document.getElementById("selMonthlyMonth").value;
        const gradeId = document.getElementById("selMonthlyGrade").value;

        const tbody = document.getElementById("monthlyTableBody");
        tbody.innerHTML = `<tr><td colspan="10" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading monthly register...</td></tr>`;

        let url = `/api/attendance/summary?year=${year}&month=${month}`;
        if (gradeId) url += `&classGradeId=${gradeId}`;

        const res = await App.apiFetch(url);
        if (res.ok && res.data && res.data.success) {
            const data = res.data.data;
            const rates = data.students || [];

            let defaulterCount = 0;
            if (rates.length === 0) {
                tbody.innerHTML = `<tr><td colspan="10" class="text-center py-5 text-secondary">No attendance records found for ${month}/${year}.</td></tr>`;
                document.getElementById("lblDefaulterCount").textContent = "0 Defaulters";
                return;
            }

            tbody.innerHTML = rates.map((s, index) => {
                const isDefaulter = s.isDefaulter || s.percentage < 75.0;
                if (isDefaulter) defaulterCount++;

                const statusBadge = isDefaulter
                    ? `<span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Low (&lt;75%)</span>`
                    : `<span class="badge badge-saas-success"><i class="bi bi-check-circle me-1"></i> Good</span>`;

                return `
                <tr class="${isDefaulter ? 'table-danger-subtle' : ''}">
                    <td class="ps-4 fw-bold font-monospace text-secondary">${s.rollNumber || (index + 1)}</td>
                    <td class="fw-semibold text-body">${s.fullName}</td>
                    <td><span class="badge bg-light text-dark border">${s.grade || '-'} ${s.section ? '(' + s.section + ')' : ''}</span></td>
                    <td class="text-success fw-bold">${s.presentDays}</td>
                    <td class="text-danger fw-bold">${s.absentDays}</td>
                    <td class="text-warning fw-bold">${s.lateDays}</td>
                    <td class="text-primary fw-bold">${s.excusedDays}</td>
                    <td class="fw-bold">${s.totalWorkingDays}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span class="fw-bold ${isDefaulter ? 'text-danger' : 'text-success'}">${s.percentage}%</span>
                            <div class="progress flex-grow-1" style="height: 6px; min-width: 60px;">
                                <div class="progress-bar ${isDefaulter ? 'bg-danger' : 'bg-success'}" style="width: ${Math.min(100, s.percentage)}%"></div>
                            </div>
                        </div>
                    </td>
                    <td class="text-end pe-4">${statusBadge}</td>
                </tr>
                `;
            }).join("");

            document.getElementById("lblDefaulterCount").textContent = `${defaulterCount} Defaulters (< 75%)`;
        } else {
            tbody.innerHTML = `<tr><td colspan="10" class="text-center py-4 text-danger">${res.data?.message || 'Failed to load monthly summary'}</td></tr>`;
        }
    }
</script>
}
