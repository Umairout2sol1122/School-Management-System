@{
    ViewData["Title"] = "Organizations & Institutions";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold mb-0">Institutions &amp; Organizations</h3>
            <span class="badge badge-saas-primary">SuperAdmin Portal</span>
        </div>
        <p class="text-secondary small mb-0 mt-1">Manage tenant educational organizations, their administrator credentials, branding logos, and module access permissions.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-saas-outline" onclick="loadOrganizations()">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </button>
        <button class="btn btn-saas-primary" onclick="openCreateOrgModal()">
            <i class="bi bi-plus-circle me-1"></i> Register Organization
        </button>
    </div>
</div>

<!-- Filters Card -->
<div class="card p-3 mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-6 col-lg-4">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0 text-secondary">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control border-start-0" id="txtSearchOrg" placeholder="Search by name, code, admin, or email..." oninput="debounceOrgSearch()">
            </div>
        </div>
        <div class="col-md-4 col-lg-3">
            <select class="form-select" id="selOrgStatus" onchange="loadOrganizations()">
                <option value="">All Subscription Statuses</option>
                <option value="true">Active Organizations</option>
                <option value="false">Suspended Organizations</option>
            </select>
        </div>
        <div class="col-md-2 text-md-end ms-auto">
            <span class="badge badge-saas-primary fs-6 px-3 py-2" id="badgeOrgTotal">0 Organizations</span>
        </div>
    </div>
</div>

<!-- Organizations Table Card -->
<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0" id="tblOrganizations">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Organization Name</th>
                    <th>Code / ID</th>
                    <th>Administrator</th>
                    <th>Contact Info</th>
                    <th>Status</th>
                    <th>Modules</th>
                    <th>Created Date</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody id="orgTableBody">
                <tr>
                    <td colspan="8" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="text-secondary small mt-2">Loading tenant organizations...</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- 1. Register Organization Modal -->
<div class="modal fade" id="modalCreateOrg" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-building-add text-primary me-2"></i> Register New Educational Institution
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formCreateOrg" onsubmit="handleCreateOrganization(event)">
                <div class="modal-body p-4">
                    <h6 class="fw-bold text-primary mb-3">1. Institution Details</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label class="form-label required">Organization Name</label>
                            <input type="text" class="form-control" id="orgName" required placeholder="e.g. Crescent Model Higher Secondary School">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label required">Short Code</label>
                            <input type="text" class="form-control text-uppercase" id="orgCode" required maxlength="10" placeholder="e.g. CMHSS">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Official Email</label>
                            <input type="email" class="form-control" id="orgEmail" placeholder="info@crescent.edu.pk">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Helpline / Phone</label>
                            <input type="text" class="form-control" id="orgPhone" placeholder="+92 42 35712345">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Physical Campus Address</label>
                            <input type="text" class="form-control" id="orgAddress" placeholder="Shadman, Lahore, Pakistan">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Primary Brand Color</label>
                            <input type="color" class="form-control form-control-color w-100" id="orgColor" value="#924EC0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Licensed Branches Quota (Capacity)</label>
                            <input type="number" class="form-control" id="orgMaxBranches" required min="1" max="100" value="3" placeholder="e.g. 3">
                            <div class="form-text small">Defines maximum campuses this institution can create (default 3).</div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary mb-3">2. Initial Organization Administrator Account</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label required">Admin First Name</label>
                            <input type="text" class="form-control" id="adminFirst" required placeholder="Muhammad">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Admin Last Name</label>
                            <input type="text" class="form-control" id="adminLast" required placeholder="Tariq">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Administrator Login Email</label>
                            <input type="email" class="form-control" id="adminEmail" required placeholder="admin@crescent.edu.pk">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Administrator Initial Password</label>
                            <input type="password" class="form-control" id="adminPassword" required placeholder="Min 8 chars, 1 upper, 1 lower, 1 digit, 1 special">
                            <div class="form-text small">e.g. Admin@2026!Pak</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-saas-primary" id="btnSubmitOrg">
                        <span class="spinner-border spinner-border-sm me-2 d-none" id="createOrgSpinner"></span>
                        <i class="bi bi-check-circle me-1" id="createOrgIcon"></i> Complete Registration
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. Edit Organization Modal -->
<div class="modal fade" id="modalEditOrg" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-pencil-square text-primary me-2"></i> Edit Educational Institution
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditOrg" onsubmit="handleEditOrganization(event)">
                <input type="hidden" id="editOrgId" />
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label required">Organization Name</label>
                            <input type="text" class="form-control" id="editOrgName" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Code (Immutable)</label>
                            <input type="text" class="form-control bg-light" id="editOrgCode" readonly disabled>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Official Email</label>
                            <input type="email" class="form-control" id="editOrgEmail">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone / Helpline</label>
                            <input type="text" class="form-control" id="editOrgPhone">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Address</label>
                            <input type="text" class="form-control" id="editOrgAddress">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Licensed Branches Quota (Capacity)</label>
                            <input type="number" class="form-control" id="editOrgMaxBranches" required min="1" max="100" value="3">
                            <div class="form-text small">Maximum campuses this institution is authorized to operate.</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Primary Color</label>
                            <input type="color" class="form-control form-control-color w-100" id="editOrgPrimaryColor">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Secondary Color</label>
                            <input type="color" class="form-control form-control-color w-100" id="editOrgSecondaryColor">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-saas-primary" id="btnSubmitEditOrg">
                        <span class="spinner-border spinner-border-sm me-2 d-none" id="editOrgSpinner"></span>
                        <i class="bi bi-save me-1" id="editOrgIcon"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. Organization Details Modal (Dossier) -->
<div class="modal fade" id="modalOrgDetails" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div id="detailsOrgLogoContainer"></div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="detailsOrgName">Organization Details</h5>
                        <div class="small text-secondary" id="detailsOrgCode">-</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="detailsOrgStatusBadge" class="badge">Active</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- Column 1: Info & Admin -->
                    <div class="col-lg-6">
                        <div class="card p-3 mb-3 border-0 bg-light">
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle me-1"></i> Institution Overview</h6>
                            <div class="row g-2 small">
                                <div class="col-4 text-secondary">Email:</div>
                                <div class="col-8 fw-semibold" id="detailsOrgEmail">-</div>
                                <div class="col-4 text-secondary">Phone:</div>
                                <div class="col-8 fw-semibold" id="detailsOrgPhone">-</div>
                                <div class="col-4 text-secondary">Address:</div>
                                <div class="col-8" id="detailsOrgAddress">-</div>
                                <div class="col-4 text-secondary">Created:</div>
                                <div class="col-8" id="detailsOrgCreated">-</div>
                                <div class="col-4 text-secondary">Last Updated:</div>
                                <div class="col-8" id="detailsOrgUpdated">-</div>
                            </div>
                        </div>

                        <div class="card p-3 border-0 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-person-badge me-1"></i> Root Administrator</h6>
                                <button class="btn btn-sm btn-outline-primary" id="btnDetailsResetPassword">
                                    <i class="bi bi-key me-1"></i> Reset Password
                                </button>
                            </div>
                            <div class="row g-2 small" id="detailsAdminInfo">
                                <div class="col-4 text-secondary">Name:</div>
                                <div class="col-8 fw-semibold" id="detailsAdminName">-</div>
                                <div class="col-4 text-secondary">Email:</div>
                                <div class="col-8 fw-semibold" id="detailsAdminEmail">-</div>
                                <div class="col-4 text-secondary">Username:</div>
                                <div class="col-8" id="detailsAdminUsername">-</div>
                                <div class="col-4 text-secondary">Phone:</div>
                                <div class="col-8" id="detailsAdminPhone">-</div>
                                <div class="col-4 text-secondary">Account Status:</div>
                                <div class="col-8" id="detailsAdminStatus">-</div>
                                <div class="col-4 text-secondary">Last Login:</div>
                                <div class="col-8" id="detailsAdminLastLogin">-</div>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Stats & Modules -->
                    <div class="col-lg-6">
                        <!-- Stat counters -->
                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <div class="p-3 text-center rounded bg-light border">
                                    <div class="fs-4 fw-bold text-primary" id="detailsCountStudents">0</div>
                                    <div class="small text-secondary">Students</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-3 text-center rounded bg-light border">
                                    <div class="fs-4 fw-bold text-success" id="detailsCountStaff">0</div>
                                    <div class="small text-secondary">Faculty/Staff</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-3 text-center rounded bg-light border">
                                    <div class="fs-4 fw-bold text-dark" id="detailsCountUsers">0</div>
                                    <div class="small text-secondary">Total Accounts</div>
                                </div>
                            </div>
                        </div>

                        <!-- Module Access Matrix -->
                        <div class="card p-3 border-0 bg-light mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-toggles me-1"></i> Active Platform Modules</h6>
                                <button class="btn btn-sm btn-saas-outline" id="btnDetailsManageModules">
                                    <i class="bi bi-gear me-1"></i> Configure Modules
                                </button>
                            </div>
                            <p class="small text-secondary mb-3">Modules enabled for this institution by SuperAdmin governance:</p>
                            <div class="d-flex flex-wrap gap-2" id="detailsModulesList">
                                <span class="badge bg-secondary">Loading modules...</span>
                            </div>
                        </div>

                        <!-- Campuses / Branches -->
                        <div class="card p-3 border-0 bg-light">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-buildings me-1"></i> Campuses &amp; Branches</h6>
                            <div id="detailsBranchesList" class="small">
                                <div class="text-secondary">Loading campuses...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- 4. Manage Organization Logo Modal -->
<div class="modal fade" id="modalOrgLogo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-image text-primary me-2"></i> Manage Institution Logo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formOrgLogo" onsubmit="handleUploadLogo(event)">
                <input type="hidden" id="logoOrgId" />
                <div class="modal-body p-4 text-center">
                    <h6 class="fw-bold mb-1" id="logoOrgName">Institution Name</h6>
                    <p class="text-secondary small mb-3">Supported formats: PNG, JPG, JPEG, WEBP, SVG (Max 2MB)</p>

                    <!-- Current Logo Preview -->
                    <div class="p-3 mb-3 border rounded bg-light d-flex align-items-center justify-content-center" style="min-height: 120px;">
                        <img id="logoPreviewImg" src="" alt="Organization Logo" class="img-fluid rounded d-none" style="max-height: 100px; max-width: 240px; object-fit: contain;" />
                        <div id="logoDefaultPlaceholder" class="text-secondary small">
                            <i class="bi bi-image fs-1 d-block mb-1 text-muted"></i>
                            No custom logo set. Using default system branding.
                        </div>
                    </div>

                    <!-- File input -->
                    <div class="mb-3 text-start">
                        <label class="form-label fw-semibold">Choose New Logo File</label>
                        <input type="file" class="form-control" id="fileLogoInput" accept="image/png,image/jpeg,image/webp,image/svg+xml" onchange="previewSelectedLogo(event)">
                        <div class="form-text small">Recommended: Transparent PNG or SVG, minimum 200x60 pixels.</div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-danger" id="btnRemoveLogo" onclick="handleRemoveLogo()">
                        <i class="bi bi-trash me-1"></i> Remove Logo
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-saas-primary" id="btnSubmitLogo">
                            <span class="spinner-border spinner-border-sm me-2 d-none" id="logoUploadSpinner"></span>
                            <i class="bi bi-cloud-arrow-up me-1" id="logoUploadIcon"></i> Upload Logo
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 5. Module Access Matrix Modal -->
<div class="modal fade" id="modalOrgModules" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-toggles text-primary me-2"></i> Manage Module Access
                    </h5>
                    <div class="small text-secondary" id="modulesOrgSubtitle">Institution Module Permissions</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="modulesOrgId" />
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                    <div>
                        <strong>Strict Permission Hierarchy:</strong> Disabled modules cannot be accessed, assigned to roles, or invoked via API by this institution.
                    </div>
                </div>

                <div class="list-group" id="modulesListGroup">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                        <span class="ms-2 small text-secondary">Loading modules...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-saas-primary" id="btnSaveModules" onclick="handleSaveModules()">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="saveModulesSpinner"></span>
                    <i class="bi bi-check-circle me-1" id="saveModulesIcon"></i> Save Module Access
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 6. Reset Administrator Password Modal -->
<div class="modal fade" id="modalResetAdminPassword" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-key text-primary me-2"></i> Reset Administrator Password
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formResetAdminPassword" onsubmit="handleResetAdminPassword(event)">
                <input type="hidden" id="resetPassOrgId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Institution</label>
                        <div class="fw-bold" id="resetPassOrgName">-</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Administrator Account</label>
                        <div class="fw-semibold text-primary font-monospace" id="resetPassAdminEmail">-</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">New Password</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="txtNewAdminPassword" required placeholder="Min 8 chars, Upper, Lower, Digit, Special">
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('txtNewAdminPassword', this)">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn btn-outline-secondary" type="button" onclick="generateRandomPassword()" title="Generate Random Password">
                                <i class="bi bi-magic"></i>
                            </button>
                        </div>
                        <div class="form-text small">Password must contain at least 8 characters with uppercase, lowercase, digit, and special symbol.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-saas-primary" id="btnSubmitResetPass">
                        <span class="spinner-border spinner-border-sm me-2 d-none" id="resetPassSpinner"></span>
                        <i class="bi bi-shield-check me-1" id="resetPassIcon"></i> Confirm Reset
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let createOrgModal = null;
    let editOrgModal = null;
    let orgDetailsModal = null;
    let orgLogoModal = null;
    let orgModulesModal = null;
    let resetPassModal = null;
    let searchTimeout = null;
    let currentOrganizations = [];

    document.addEventListener("DOMContentLoaded", () => {
        if (!App.isAuthenticated()) {
            window.location.href = "/login";
            return;
        }
        if (!App.hasRole('SuperAdmin')) {
            App.showToast('error', 'Access Denied', 'The Organizations module is strictly reserved for Platform SuperAdmins.');
            setTimeout(() => { window.location.href = "/"; }, 800);
            return;
        }

        createOrgModal = new bootstrap.Modal(document.getElementById("modalCreateOrg"));
        editOrgModal = new bootstrap.Modal(document.getElementById("modalEditOrg"));
        orgDetailsModal = new bootstrap.Modal(document.getElementById("modalOrgDetails"));
        orgLogoModal = new bootstrap.Modal(document.getElementById("modalOrgLogo"));
        orgModulesModal = new bootstrap.Modal(document.getElementById("modalOrgModules"));
        resetPassModal = new bootstrap.Modal(document.getElementById("modalResetAdminPassword"));

        // Check URL parameters for pre-filtering (e.g. from Dashboard)
        const params = new URLSearchParams(window.location.search);
        if (params.has('status')) {
            const statusSelect = document.getElementById("selOrgStatus");
            if (statusSelect) statusSelect.value = params.get('status');
        }

        loadOrganizations();
    });

    function debounceOrgSearch() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(loadOrganizations, 300);
    }

    async function loadOrganizations() {
        const tbody = document.getElementById("orgTableBody");
        const search = document.getElementById("txtSearchOrg").value.trim();
        const status = document.getElementById("selOrgStatus").value;

        let url = "/api/organizations?";
        if (search) url += `search=${encodeURIComponent(search)}&`;
        if (status) url += `isActive=${encodeURIComponent(status)}&`;

        const res = await App.apiFetch(url);
        if (res.ok && res.data && res.data.success) {
            currentOrganizations = res.data.data;
            document.getElementById("badgeOrgTotal").textContent = `${currentOrganizations.length} Organizations`;
            renderOrganizations(currentOrganizations);
        } else {
            tbody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle me-1"></i> ${res.data?.message || 'Failed to load organizations'}</td></tr>`;
        }
    }

    function renderOrganizations(orgs) {
        const tbody = document.getElementById("orgTableBody");
        if (orgs.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" class="text-center py-5 text-secondary"><i class="bi bi-inbox fs-1 d-block mb-2"></i> No organizations found matching your criteria.</td></tr>`;
            return;
        }

        tbody.innerHTML = orgs.map(o => {
            const hasLogo = !!o.logoUrl;
            const logoHtml = hasLogo
                ? `<img src="${o.logoUrl}" alt="${o.name}" class="rounded-3 shadow-sm" style="width: 40px; height: 40px; object-fit: contain; background: #fff; padding: 2px; border: 1px solid var(--saas-border);" />`
                : `<div class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 40px; height: 40px; background: ${o.themePrimaryColor || '#924EC0'};">${(o.name || 'S').substring(0, 1).toUpperCase()}</div>`;

            const adminText = o.adminName
                ? `<div class="fw-semibold text-body">${o.adminName}</div><div class="small text-secondary">${o.adminEmail || ''}</div>`
                : `<span class="text-muted small">No Admin Assigned</span>`;

            return `
            <tr>
                <td class="ps-4">
                    <div class="d-flex align-items-center gap-3">
                        ${logoHtml}
                        <div>
                            <div class="fw-bold text-body cursor-pointer" onclick="openOrgDetails('${o.id}')" title="Click to view details">${o.name}</div>
                            <div class="small text-secondary"><span class="badge badge-saas-primary me-1">${o.branchesCount || 1} / ${o.maxBranches || 5} Campuses</span> • ${o.usersCount || 0} Accounts</div>
                        </div>
                    </div>
                </td>
                <td>
                    <span class="badge badge-saas-primary font-monospace">${o.code}</span>
                </td>
                <td>
                    ${adminText}
                </td>
                <td>
                    <div class="small"><i class="bi bi-envelope me-1 text-secondary"></i> ${o.email || '-'}</div>
                    <div class="small text-secondary"><i class="bi bi-telephone me-1"></i> ${o.phone || '-'}</div>
                </td>
                <td>
                    <span class="badge ${o.isActive ? 'badge-saas-success' : 'badge bg-danger'}">
                        ${o.isActive ? 'Active' : 'Suspended'}
                    </span>
                </td>
                <td>
                    <span class="badge bg-light text-dark border cursor-pointer" onclick="openModulesModal('${o.id}', '${encodeURIComponent(o.name)}')" title="Configure Modules">
                        <i class="bi bi-toggles me-1 text-primary"></i> ${o.enabledModulesCount || 0} Modules
                    </span>
                </td>
                <td>
                    <span class="small text-secondary">${new Date(o.createdAtUtc).toLocaleDateString()}</span>
                </td>
                <td class="text-end pe-4">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-saas-outline dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Actions
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="openOrgDetails('${o.id}')"><i class="bi bi-eye me-2 text-primary"></i> View Details</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="openEditOrgModal('${o.id}')"><i class="bi bi-pencil me-2 text-secondary"></i> Edit Details</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="openLogoModal('${o.id}', '${encodeURIComponent(o.name)}', '${o.logoUrl || ''}')"><i class="bi bi-image me-2 text-info"></i> Manage Logo</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="openModulesModal('${o.id}', '${encodeURIComponent(o.name)}')"><i class="bi bi-toggles me-2 text-primary"></i> Module Access</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="openResetPasswordModal('${o.id}', '${encodeURIComponent(o.name)}', '${o.adminEmail || ''}')"><i class="bi bi-key me-2 text-warning"></i> Reset Admin Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item ${o.isActive ? 'text-warning' : 'text-success'}" href="javascript:void(0)" onclick="toggleOrgStatus('${o.id}', '${encodeURIComponent(o.name)}', ${o.isActive})">
                                    <i class="bi ${o.isActive ? 'bi-pause-circle text-warning' : 'bi-play-circle text-success'} me-2"></i> ${o.isActive ? 'Suspend Institution' : 'Activate Institution'}
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
            `;
        }).join("");
    }

    // --- CREATE ORGANIZATION ---
    function openCreateOrgModal() {
        document.getElementById("formCreateOrg").reset();
        document.getElementById("orgColor").value = "#924EC0";
        document.getElementById("orgMaxBranches").value = "3";
        document.getElementById("adminPassword").value = "Admin@2026!Pak";
        createOrgModal.show();
    }

    async function handleCreateOrganization(e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitOrg");
        const spin = document.getElementById("createOrgSpinner");
        const icon = document.getElementById("createOrgIcon");

        btn.disabled = true;
        spin.classList.remove("d-none");
        icon.classList.add("d-none");

        const body = {
            name: document.getElementById("orgName").value.trim(),
            code: document.getElementById("orgCode").value.trim().toUpperCase(),
            email: document.getElementById("orgEmail").value.trim(),
            phone: document.getElementById("orgPhone").value.trim(),
            address: document.getElementById("orgAddress").value.trim(),
            themePrimaryColor: document.getElementById("orgColor").value,
            maxBranches: parseInt(document.getElementById("orgMaxBranches").value) || 3,
            initialAdminFirstName: document.getElementById("adminFirst").value.trim(),
            initialAdminLastName: document.getElementById("adminLast").value.trim(),
            initialAdminEmail: document.getElementById("adminEmail").value.trim(),
            initialAdminPassword: document.getElementById("adminPassword").value
        };

        const res = await App.apiFetch("/api/organizations", {
            method: "POST",
            body: JSON.stringify(body)
        });

        btn.disabled = false;
        spin.classList.add("d-none");
        icon.classList.remove("d-none");

        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Registered!', 'Educational institution registered successfully with initial administrator.');
            createOrgModal.hide();
            loadOrganizations();
        } else {
            App.showToast('error', 'Registration Failed', res.data?.message || 'Check the provided details.');
        }
    }

    // --- EDIT ORGANIZATION ---
    async function openEditOrgModal(id) {
        const res = await App.apiFetch(`/api/organizations/${id}`);
        if (!res.ok || !res.data || !res.data.success) {
            App.showToast('error', 'Error', 'Failed to load organization for editing.');
            return;
        }

        const org = res.data.data;
        document.getElementById("editOrgId").value = org.id;
        document.getElementById("editOrgName").value = org.name;
        document.getElementById("editOrgCode").value = org.code;
        document.getElementById("editOrgEmail").value = org.email || '';
        document.getElementById("editOrgPhone").value = org.phone || '';
        document.getElementById("editOrgAddress").value = org.address || '';
        document.getElementById("editOrgMaxBranches").value = org.maxBranches || 5;
        document.getElementById("editOrgPrimaryColor").value = org.themePrimaryColor || '#924EC0';
        document.getElementById("editOrgSecondaryColor").value = org.themeSecondaryColor || '#5840BA';

        editOrgModal.show();
    }

    async function handleEditOrganization(e) {
        e.preventDefault();
        const id = document.getElementById("editOrgId").value;
        const btn = document.getElementById("btnSubmitEditOrg");
        const spin = document.getElementById("editOrgSpinner");
        const icon = document.getElementById("editOrgIcon");

        btn.disabled = true;
        spin.classList.remove("d-none");
        icon.classList.add("d-none");

        const body = {
            name: document.getElementById("editOrgName").value.trim(),
            email: document.getElementById("editOrgEmail").value.trim(),
            phone: document.getElementById("editOrgPhone").value.trim(),
            address: document.getElementById("editOrgAddress").value.trim(),
            maxBranches: parseInt(document.getElementById("editOrgMaxBranches").value) || 3,
            themePrimaryColor: document.getElementById("editOrgPrimaryColor").value,
            themeSecondaryColor: document.getElementById("editOrgSecondaryColor").value,
            themeDarkMode: true
        };

        const res = await App.apiFetch(`/api/organizations/${id}`, {
            method: "PUT",
            body: JSON.stringify(body)
        });

        btn.disabled = false;
        spin.classList.add("d-none");
        icon.classList.remove("d-none");

        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Updated!', 'Organization details saved successfully.');
            editOrgModal.hide();
            loadOrganizations();
        } else {
            App.showToast('error', 'Update Failed', res.data?.message || 'Failed to update organization.');
        }
    }

    // --- VIEW ORGANIZATION DETAILS (DOSSIER) ---
    async function openOrgDetails(id) {
        const res = await App.apiFetch(`/api/organizations/${id}`);
        if (!res.ok || !res.data || !res.data.success) {
            App.showToast('error', 'Error', 'Failed to load organization details.');
            return;
        }

        const org = res.data.data;
        document.getElementById("detailsOrgName").textContent = org.name;
        document.getElementById("detailsOrgCode").textContent = `Code: ${org.code} • ID: ${org.id}`;
        document.getElementById("detailsOrgEmail").textContent = org.email || '-';
        document.getElementById("detailsOrgPhone").textContent = org.phone || '-';
        document.getElementById("detailsOrgAddress").textContent = org.address || '-';
        document.getElementById("detailsOrgCreated").textContent = new Date(org.createdAtUtc).toLocaleString();
        document.getElementById("detailsOrgUpdated").textContent = org.updatedAtUtc ? new Date(org.updatedAtUtc).toLocaleString() : 'Never modified';

        // Logo
        const logoContainer = document.getElementById("detailsOrgLogoContainer");
        if (org.logoUrl) {
            logoContainer.innerHTML = `<img src="${org.logoUrl}" alt="${org.name}" class="rounded-3 shadow-sm" style="width: 48px; height: 48px; object-fit: contain; background: #fff; padding: 2px; border: 1px solid var(--saas-border);" />`;
        } else {
            logoContainer.innerHTML = `<div class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 48px; height: 48px; background: ${org.themePrimaryColor || '#924EC0'}; font-size: 1.25rem;">${(org.name || 'S').substring(0, 1).toUpperCase()}</div>`;
        }

        // Status Badge
        const statusBadge = document.getElementById("detailsOrgStatusBadge");
        statusBadge.className = `badge ${org.isActive ? 'badge-saas-success' : 'badge bg-danger'}`;
        statusBadge.textContent = org.isActive ? 'Active Subscription' : 'Suspended';

        // Counters
        document.getElementById("detailsCountStudents").textContent = org.studentsCount || 0;
        document.getElementById("detailsCountStaff").textContent = org.staffCount || 0;
        document.getElementById("detailsCountUsers").textContent = org.totalUsersCount || 0;

        // Admin info
        const admin = org.adminUser;
        if (admin) {
            document.getElementById("detailsAdminName").textContent = admin.fullName || '-';
            document.getElementById("detailsAdminEmail").textContent = admin.email || '-';
            document.getElementById("detailsAdminUsername").textContent = admin.username || '-';
            document.getElementById("detailsAdminPhone").textContent = admin.phoneNumber || '-';
            document.getElementById("detailsAdminStatus").innerHTML = admin.isActive
                ? `<span class="badge badge-saas-success">Active</span>`
                : `<span class="badge bg-danger">Deactivated</span>`;
            document.getElementById("detailsAdminLastLogin").textContent = admin.lastLoginAtUtc ? new Date(admin.lastLoginAtUtc).toLocaleString() : 'Never logged in';

            document.getElementById("btnDetailsResetPassword").onclick = () => {
                orgDetailsModal.hide();
                openResetPasswordModal(org.id, encodeURIComponent(org.name), admin.email);
            };
        } else {
            document.getElementById("detailsAdminInfo").innerHTML = `<div class="col-12 text-muted">No Administrator profile registered for this institution.</div>`;
        }

        // Modules Matrix
        const modulesContainer = document.getElementById("detailsModulesList");
        if (org.modules && org.modules.length > 0) {
            modulesContainer.innerHTML = org.modules.map(m => `
                <span class="badge ${m.isEnabled ? 'badge-saas-success' : 'badge bg-secondary'} p-2">
                    <i class="bi ${m.isEnabled ? 'bi-check-circle-fill' : 'bi-x-circle'} me-1"></i> ${m.moduleName}
                </span>
            `).join("");
        } else {
            modulesContainer.innerHTML = `<span class="text-secondary small">No module access configured.</span>`;
        }

        document.getElementById("btnDetailsManageModules").onclick = () => {
            orgDetailsModal.hide();
            openModulesModal(org.id, encodeURIComponent(org.name));
        };

        // Branches
        const branchesContainer = document.getElementById("detailsBranchesList");
        if (org.branches && org.branches.length > 0) {
            branchesContainer.innerHTML = org.branches.map(b => `
                <div class="p-2 mb-1 rounded bg-white border d-flex justify-content-between align-items-center">
                    <div>
                        <strong>${b.name}</strong> <span class="badge badge-saas-primary ms-1">${b.code}</span>
                        ${b.isMainBranch ? '<span class="badge bg-info text-dark ms-1">Main</span>' : ''}
                    </div>
                    <span class="text-secondary small">${b.email || b.phone || ''}</span>
                </div>
            `).join("");
        } else {
            branchesContainer.innerHTML = `<div class="text-secondary">No campuses registered.</div>`;
        }

        orgDetailsModal.show();
    }

    // --- MANAGE LOGO ---
    function openLogoModal(id, encodedName, currentLogoUrl) {
        const name = decodeURIComponent(encodedName);
        document.getElementById("logoOrgId").value = id;
        document.getElementById("logoOrgName").textContent = name;
        document.getElementById("fileLogoInput").value = "";

        const previewImg = document.getElementById("logoPreviewImg");
        const placeholder = document.getElementById("logoDefaultPlaceholder");
        const removeBtn = document.getElementById("btnRemoveLogo");

        if (currentLogoUrl && currentLogoUrl !== 'null' && currentLogoUrl !== '') {
            previewImg.src = currentLogoUrl;
            previewImg.classList.remove("d-none");
            placeholder.classList.add("d-none");
            removeBtn.classList.remove("d-none");
        } else {
            previewImg.src = "";
            previewImg.classList.add("d-none");
            placeholder.classList.remove("d-none");
            removeBtn.classList.add("d-none");
        }

        orgLogoModal.show();
    }

    function previewSelectedLogo(e) {
        const file = e.target.files[0];
        if (!file) return;

        // Validation: 2MB max
        if (file.size > 2 * 1024 * 1024) {
            App.showToast('error', 'File Too Large', 'Please select an image file under 2MB.');
            e.target.value = "";
            return;
        }

        const reader = new FileReader();
        reader.onload = function(evt) {
            const previewImg = document.getElementById("logoPreviewImg");
            const placeholder = document.getElementById("logoDefaultPlaceholder");
            previewImg.src = evt.target.result;
            previewImg.classList.remove("d-none");
            placeholder.classList.add("d-none");
        };
        reader.readAsDataURL(file);
    }

    async function handleUploadLogo(e) {
        e.preventDefault();
        const id = document.getElementById("logoOrgId").value;
        const fileInput = document.getElementById("fileLogoInput");

        if (!fileInput.files || fileInput.files.length === 0) {
            App.showToast('error', 'Select Image', 'Please choose an image file to upload.');
            return;
        }

        const file = fileInput.files[0];
        if (file.size > 2 * 1024 * 1024) {
            App.showToast('error', 'File Too Large', 'File exceeds the 2MB limit.');
            return;
        }

        const formData = new FormData();
        formData.append("file", file);

        const btn = document.getElementById("btnSubmitLogo");
        const spin = document.getElementById("logoUploadSpinner");
        const icon = document.getElementById("logoUploadIcon");

        btn.disabled = true;
        spin.classList.remove("d-none");
        icon.classList.add("d-none");

        try {
            const token = localStorage.getItem('sms_auth_token') || sessionStorage.getItem('sms_auth_token');
            const response = await fetch(`/api/organizations/${id}/logo`, {
                method: "POST",
                headers: {
                    "Authorization": `Bearer ${token}`
                },
                body: formData
            });

            const data = await response.json();
            btn.disabled = false;
            spin.classList.add("d-none");
            icon.classList.remove("d-none");

            if (response.ok && data.success) {
                App.showToast('success', 'Logo Saved!', 'Organization logo uploaded and propagated successfully.');
                orgLogoModal.hide();
                loadOrganizations();
            } else {
                App.showToast('error', 'Upload Failed', data.message || 'Could not upload logo.');
            }
        } catch (err) {
            btn.disabled = false;
            spin.classList.add("d-none");
            icon.classList.remove("d-none");
            App.showToast('error', 'Network Error', 'Failed to communicate with server.');
        }
    }

    async function handleRemoveLogo() {
        const id = document.getElementById("logoOrgId").value;
        const orgName = document.getElementById("logoOrgName").textContent;

        const result = await Swal.fire({
            title: 'Remove Logo?',
            text: `Are you sure you want to remove the custom logo for "${orgName}"? System will revert to default branding.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, Remove Logo'
        });

        if (result.isConfirmed) {
            const res = await App.apiFetch(`/api/organizations/${id}/logo`, {
                method: "DELETE"
            });

            if (res.ok && res.data && res.data.success) {
                App.showToast('success', 'Logo Removed', 'Custom logo deleted. Reverted to default branding.');
                orgLogoModal.hide();
                loadOrganizations();
            } else {
                App.showToast('error', 'Error', res.data?.message || 'Failed to remove logo.');
            }
        }
    }

    // --- MODULE ACCESS MATRIX ---
    async function openModulesModal(id, encodedName) {
        const name = decodeURIComponent(encodedName);
        document.getElementById("modulesOrgId").value = id;
        document.getElementById("modulesOrgSubtitle").textContent = `Configure allowed application modules for: ${name}`;

        const container = document.getElementById("modulesListGroup");
        container.innerHTML = `<div class="text-center py-4"><div class="spinner-border text-primary spinner-border-sm"></div><span class="ms-2 small text-secondary">Loading module matrix...</span></div>`;

        orgModulesModal.show();

        const res = await App.apiFetch(`/api/organizations/${id}/modules`);
        if (res.ok && res.data && res.data.success) {
            const modules = res.data.data;
            renderModulesList(modules);
        } else {
            container.innerHTML = `<div class="text-danger text-center py-3"><i class="bi bi-exclamation-circle me-1"></i> Failed to load modules.</div>`;
        }
    }

    function renderModulesList(modules) {
        const container = document.getElementById("modulesListGroup");
        container.innerHTML = modules.map(m => `
            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div class="me-3">
                    <div class="fw-bold d-flex align-items-center gap-2">
                        <span>${m.displayName || m.moduleName}</span>
                        <span class="badge bg-light text-secondary border font-monospace small">${m.moduleName}</span>
                    </div>
                    <div class="small text-secondary mt-1">${m.description || ''}</div>
                </div>
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input js-module-toggle cursor-pointer" type="checkbox" role="switch" data-module="${m.moduleName}" ${m.isEnabled ? 'checked' : ''}>
                </div>
            </div>
        `).join("");
    }

    async function handleSaveModules() {
        const id = document.getElementById("modulesOrgId").value;
        const btn = document.getElementById("btnSaveModules");
        const spin = document.getElementById("saveModulesSpinner");
        const icon = document.getElementById("saveModulesIcon");

        const toggles = document.querySelectorAll(".js-module-toggle");
        const moduleList = [];
        toggles.forEach(t => {
            moduleList.push({
                moduleName: t.getAttribute("data-module"),
                isEnabled: t.checked
            });
        });

        btn.disabled = true;
        spin.classList.remove("d-none");
        icon.classList.add("d-none");

        const res = await App.apiFetch(`/api/organizations/${id}/modules`, {
            method: "PUT",
            body: JSON.stringify({ modules: moduleList })
        });

        btn.disabled = false;
        spin.classList.add("d-none");
        icon.classList.remove("d-none");

        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Permissions Updated!', 'Organization module permissions saved. Changes enforce immediately.');
            orgModulesModal.hide();
            loadOrganizations();
        } else {
            App.showToast('error', 'Save Failed', res.data?.message || 'Failed to update module access.');
        }
    }

    // --- RESET ADMIN PASSWORD ---
    function openResetPasswordModal(id, encodedName, adminEmail) {
        const name = decodeURIComponent(encodedName);
        document.getElementById("resetPassOrgId").value = id;
        document.getElementById("resetPassOrgName").textContent = name;
        document.getElementById("resetPassAdminEmail").textContent = adminEmail || 'admin@school.edu';
        document.getElementById("txtNewAdminPassword").value = "Admin@2026!Pak";

        resetPassModal.show();
    }

    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector("i");
        if (input.type === "password") {
            input.type = "text";
            icon.className = "bi bi-eye-slash";
        } else {
            input.type = "password";
            icon.className = "bi bi-eye";
        }
    }

    function generateRandomPassword() {
        const uppers = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const digits = "23456789";

        let pass = "Admin";
        for (let i = 0; i < 3; i++) pass += uppers[Math.floor(Math.random() * uppers.length)];
        for (let i = 0; i < 3; i++) pass += digits[Math.floor(Math.random() * digits.length)];
        pass += "!2026";
        document.getElementById("txtNewAdminPassword").value = pass;
    }

    async function handleResetAdminPassword(e) {
        e.preventDefault();
        const id = document.getElementById("resetPassOrgId").value;
        const newPassword = document.getElementById("txtNewAdminPassword").value;
        const adminEmail = document.getElementById("resetPassAdminEmail").textContent;

        const result = await Swal.fire({
            title: 'Confirm Password Reset',
            text: `Reset login password for administrator "${adminEmail}"?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: 'var(--saas-primary)',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, Reset Password'
        });

        if (!result.isConfirmed) return;

        const btn = document.getElementById("btnSubmitResetPass");
        const spin = document.getElementById("resetPassSpinner");
        const icon = document.getElementById("resetPassIcon");

        btn.disabled = true;
        spin.classList.remove("d-none");
        icon.classList.add("d-none");

        const res = await App.apiFetch(`/api/organizations/${id}/admin/reset-password`, {
            method: "POST",
            body: JSON.stringify({ newPassword })
        });

        btn.disabled = false;
        spin.classList.add("d-none");
        icon.classList.remove("d-none");

        if (res.ok && res.data && res.data.success) {
            Swal.fire({
                title: 'Password Reset Complete!',
                html: `Administrator <strong>${adminEmail}</strong> password was reset successfully.<br><br>New Password: <code class="fs-5">${newPassword}</code>`,
                icon: 'success',
                confirmButtonColor: 'var(--saas-primary)'
            });
            resetPassModal.hide();
        } else {
            App.showToast('error', 'Reset Failed', res.data?.message || 'Password complexity requirements not met.');
        }
    }

    // --- TOGGLE SUBSCRIPTION STATUS ---
    async function toggleOrgStatus(id, encodedName, currentStatus) {
        const name = decodeURIComponent(encodedName);
        const actionText = currentStatus ? "suspend" : "activate";
        const result = await Swal.fire({
            title: `Are you sure?`,
            text: `Do you wish to ${actionText} subscription access for "${name}"? Suspended institutions cannot access any platform features.`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: currentStatus ? "#d33" : "var(--saas-primary)",
            cancelButtonColor: "#6c757d",
            confirmButtonText: `Yes, ${actionText}`
        });

        if (result.isConfirmed) {
            const res = await App.apiFetch(`/api/organizations/${id}/toggle-status`, {
                method: "PATCH"
            });

            if (res.ok && res.data && res.data.success) {
                App.showToast('success', 'Status Changed', `Institution "${name}" is now ${(currentStatus ? "Suspended" : "Active")}.`);
                loadOrganizations();
            } else {
                App.showToast('error', 'Error', res.data?.message || 'Failed to update status.');
            }
        }
    }
</script>
}
