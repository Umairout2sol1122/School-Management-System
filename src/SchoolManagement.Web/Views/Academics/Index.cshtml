@{
    ViewData["Title"] = "Academic Architecture & Class Management";
}

<div class="row g-4">
    <!-- Top Header Banner -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm" style="background: linear-gradient(135deg, rgba(146, 78, 192, 0.08) 0%, rgba(146, 78, 192, 0.02) 100%); border-left: 4px solid var(--saas-primary) !important;">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                         style="width: 56px; height: 56px; background: var(--saas-primary-gradient); font-size: 1.5rem;">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h3 class="fw-bold mb-0 text-body">Academic Architecture</h3>
                            <span class="badge badge-saas-primary">Multi-Curricular</span>
                        </div>
                        <p class="text-secondary small mb-0 mt-1">
                            Configure dynamic classes, institute diploma courses, departments, academic sessions, subjects, and teaching allocations.
                        </p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-saas-outline" onclick="refreshCurrentTab()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                    </button>
                    <button class="btn btn-saas-primary" id="btnPrimaryAction" onclick="handlePrimaryAction()">
                        <i class="bi bi-plus-circle me-1"></i> Add Class / Grade
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="col-12">
        <ul class="nav nav-pills custom-saas-pills gap-2 p-2 rounded-3 shadow-sm" id="academicTabs" role="tablist" style="background: var(--saas-card-bg); border: 1px solid var(--saas-border);">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="tab-classes-btn" data-bs-toggle="pill" data-bs-target="#tab-classes" type="button" role="tab" onclick="switchTab('classes')">
                    <i class="bi bi-grid-fill me-1"></i> Classes &amp; Grades
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="tab-departments-btn" data-bs-toggle="pill" data-bs-target="#tab-departments" type="button" role="tab" onclick="switchTab('departments')">
                    <i class="bi bi-diagram-3-fill me-1"></i> Departments
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="tab-sessions-btn" data-bs-toggle="pill" data-bs-target="#tab-sessions" type="button" role="tab" onclick="switchTab('sessions')">
                    <i class="bi bi-calendar3 me-1"></i> Academic Sessions
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="tab-subjects-btn" data-bs-toggle="pill" data-bs-target="#tab-subjects" type="button" role="tab" onclick="switchTab('subjects')">
                    <i class="bi bi-book-half me-1"></i> Subjects &amp; Courses
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="tab-assignments-btn" data-bs-toggle="pill" data-bs-target="#tab-assignments" type="button" role="tab" onclick="switchTab('assignments')">
                    <i class="bi bi-person-check-fill me-1"></i> Course Allocations
                </button>
            </li>
        </ul>
    </div>

    <!-- Tab Contents -->
    <div class="col-12">
        <div class="tab-content" id="academicTabContent">
            
            <!-- 1. CLASSES & GRADES -->
            <div class="tab-pane fade show active" id="tab-classes" role="tabpanel">
                <div class="card p-0 shadow-sm border-0">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="fw-bold fs-6">Registered Classes, Programs &amp; Grade Levels</div>
                        <div class="text-secondary small">Classes support schools (K-12) &amp; vocational institutes (Semesters, Diplomas, Batches)</div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Order</th>
                                    <th>Class / Program Name</th>
                                    <th>Code</th>
                                    <th>Department</th>
                                    <th>Capacity</th>
                                    <th>Sections</th>
                                    <th>Enrolled</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="tblClassesBody">
                                <tr><td colspan="9" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading classes...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 2. DEPARTMENTS -->
            <div class="tab-pane fade" id="tab-departments" role="tabpanel">
                <div class="card p-0 shadow-sm border-0">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="fw-bold fs-6">Institutional Academic &amp; Administrative Departments</div>
                        <div class="text-secondary small">Faculty, subjects, and courses are organized under these departments</div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Department Name</th>
                                    <th>Description</th>
                                    <th>Head of Department</th>
                                    <th>Staff Count</th>
                                    <th>Courses</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="tblDepartmentsBody">
                                <tr><td colspan="8" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading departments...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 3. ACADEMIC SESSIONS -->
            <div class="tab-pane fade" id="tab-sessions" role="tabpanel">
                <div class="card p-0 shadow-sm border-0">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="fw-bold fs-6">Academic Years, Terms, Semesters &amp; Batches</div>
                        <div class="text-secondary small">Only one session can be marked as current active per institution</div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Session Name</th>
                                    <th>Code</th>
                                    <th>Type</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                    <th>Active Flag</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="tblSessionsBody">
                                <tr><td colspan="8" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading sessions...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 4. SUBJECTS & COURSES -->
            <div class="tab-pane fade" id="tab-subjects" role="tabpanel">
                <div class="card p-0 shadow-sm border-0">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="fw-bold fs-6">Curricular Subjects &amp; Course Catalog</div>
                        <div class="text-secondary small">Supports traditional school subjects and modular professional certifications</div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Subject / Course Title</th>
                                    <th>Department</th>
                                    <th>Grade / Program</th>
                                    <th>Credits / Hours</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="tblSubjectsBody">
                                <tr><td colspan="8" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading subjects...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 5. COURSE ALLOCATIONS -->
            <div class="tab-pane fade" id="tab-assignments" role="tabpanel">
                <div class="card p-0 shadow-sm border-0">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="fw-bold fs-6">Teacher Course &amp; Section Allocations</div>
                        <div class="text-secondary small">Class Section &bull; Subject Course &bull; Assigned Faculty Member</div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Class &amp; Section</th>
                                    <th>Subject / Course</th>
                                    <th>Assigned Teacher / Instructor</th>
                                    <th>Academic Session</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="tblAssignmentsBody">
                                <tr><td colspan="6" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading allocations...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODALS                                         -->
<!-- ============================================== -->

<!-- 1. Add Class Modal -->
<div class="modal fade" id="modalAddClass" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-grid-plus text-primary me-2"></i> Create Class / Grade Level</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formAddClass" onsubmit="submitAddClass(event)">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label required">Class / Program Name</label>
                        <input type="text" class="form-control" id="clsName" required placeholder="e.g. Grade 1, Playgroup, Diploma Web Dev">
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label required">Code</label>
                            <input type="text" class="form-control" id="clsCode" required placeholder="e.g. G-01, DIP-WD">
                        </div>
                        <div class="col-6">
                            <label class="form-label required">Display Order</label>
                            <input type="number" class="form-control" id="clsOrder" value="1" min="0">
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label required">Capacity</label>
                            <input type="number" class="form-control" id="clsCapacity" value="40" min="1">
                        </div>
                        <div class="col-6">
                            <label class="form-label">Department</label>
                            <select class="form-select" id="clsDepartment">
                                <option value="">None / General</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-saas-primary">Save Class</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. Add Department Modal -->
<div class="modal fade" id="modalAddDept" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-diagram-3 text-primary me-2"></i> Create Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formAddDept" onsubmit="submitAddDept(event)">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label required">Department Name</label>
                        <input type="text" class="form-control" id="deptName" required placeholder="e.g. Science, Computer Sciences, Languages">
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Department Code</label>
                        <input type="text" class="form-control" id="deptCode" required placeholder="e.g. SCI, CS, ENG">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="deptDesc" rows="2" placeholder="Brief outline of department scope..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-saas-primary">Create Department</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. Add Session Modal -->
<div class="modal fade" id="modalAddSession" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-calendar-plus text-primary me-2"></i> Create Academic Session</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formAddSession" onsubmit="submitAddSession(event)">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label required">Session Name</label>
                        <input type="text" class="form-control" id="sesName" required placeholder="e.g. 2026-2027, Batch Jan-2026, Spring 2026">
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label required">Code</label>
                            <input type="text" class="form-control" id="sesCode" required placeholder="e.g. 2026-27, BATCH-26A">
                        </div>
                        <div class="col-6">
                            <label class="form-label required">Type</label>
                            <select class="form-select" id="sesType">
                                <option value="Annual">Annual (School)</option>
                                <option value="Semester">Semester (College)</option>
                                <option value="Term">Term (3-Term School)</option>
                                <option value="Batch">Batch (Vocational)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label required">Start Date</label>
                            <input type="date" class="form-control" id="sesStart" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label required">End Date</label>
                            <input type="date" class="form-control" id="sesEnd" required>
                        </div>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" id="sesIsCurrent" checked>
                        <label class="form-check-label fw-semibold" for="sesIsCurrent">Set as current active academic session</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-saas-primary">Create Session</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 4. Add Subject Modal -->
<div class="modal fade" id="modalAddSubject" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-book text-primary me-2"></i> Create Subject / Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formAddSubject" onsubmit="submitAddSubject(event)">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label required">Subject / Course Name</label>
                        <input type="text" class="form-control" id="subName" required placeholder="e.g. Mathematics, Graphic Design, Physics">
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label required">Code</label>
                            <input type="text" class="form-control" id="subCode" required placeholder="e.g. MATH-101, GD-201">
                        </div>
                        <div class="col-6">
                            <label class="form-label required">Credits / Hours</label>
                            <input type="number" class="form-control" id="subCredits" value="3" min="1">
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">Type</label>
                            <select class="form-select" id="subType">
                                <option value="Core">Core / Mandatory</option>
                                <option value="Elective">Elective</option>
                                <option value="Practical">Practical / Lab</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Department</label>
                            <select class="form-select" id="subDept">
                                <option value="">None / General</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Class / Grade Level</label>
                        <select class="form-select" id="subClass">
                            <option value="">All Classes / Common</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-saas-primary">Create Subject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 5. Add Course Assignment Modal -->
<div class="modal fade" id="modalAddAssignment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-check text-primary me-2"></i> Allocate Teacher to Course</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formAddAssignment" onsubmit="submitAddAssignment(event)">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label required">Select Class &amp; Section</label>
                        <select class="form-select" id="asgSection" required>
                            <option value="">Loading sections...</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Select Subject / Course</label>
                        <select class="form-select" id="asgSubject" required>
                            <option value="">Loading subjects...</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Assigned Teacher / Instructor</label>
                        <select class="form-select" id="asgTeacher" required>
                            <option value="">Loading faculty...</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-saas-primary">Confirm Allocation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let activeTab = 'classes';
    let departmentsList = [];
    let classesList = [];
    let subjectsList = [];
    let teachersList = [];
    let sectionsList = [];

    document.addEventListener("DOMContentLoaded", () => {
        if (!App.isAuthenticated()) {
            window.location.href = "/login";
            return;
        }
        loadAllData();
    });

    async function loadAllData() {
        await Promise.all([
            loadClasses(),
            loadDepartments(),
            loadSessions(),
            loadSubjects(),
            loadAssignments(),
            loadTeachers()
        ]);
    }

    function switchTab(tab) {
        activeTab = tab;
        const btn = document.getElementById('btnPrimaryAction');
        if (tab === 'classes') {
            btn.innerHTML = '<i class="bi bi-plus-circle me-1"></i> Add Class / Grade';
        } else if (tab === 'departments') {
            btn.innerHTML = '<i class="bi bi-plus-circle me-1"></i> Add Department';
        } else if (tab === 'sessions') {
            btn.innerHTML = '<i class="bi bi-plus-circle me-1"></i> Add Academic Session';
        } else if (tab === 'subjects') {
            btn.innerHTML = '<i class="bi bi-plus-circle me-1"></i> Add Subject / Course';
        } else if (tab === 'assignments') {
            btn.innerHTML = '<i class="bi bi-plus-circle me-1"></i> Allocate Teacher';
        }
    }

    function handlePrimaryAction() {
        if (activeTab === 'classes') new bootstrap.Modal(document.getElementById('modalAddClass')).show();
        else if (activeTab === 'departments') new bootstrap.Modal(document.getElementById('modalAddDept')).show();
        else if (activeTab === 'sessions') new bootstrap.Modal(document.getElementById('modalAddSession')).show();
        else if (activeTab === 'subjects') new bootstrap.Modal(document.getElementById('modalAddSubject')).show();
        else if (activeTab === 'assignments') new bootstrap.Modal(document.getElementById('modalAddAssignment')).show();
    }

    function refreshCurrentTab() {
        if (activeTab === 'classes') loadClasses();
        else if (activeTab === 'departments') loadDepartments();
        else if (activeTab === 'sessions') loadSessions();
        else if (activeTab === 'subjects') loadSubjects();
        else if (activeTab === 'assignments') loadAssignments();
    }

    // 1. CLASSES
    async function loadClasses() {
        const res = await App.apiFetch('/api/academics/classes');
        const tbody = document.getElementById('tblClassesBody');
        if (res.ok && res.data && res.data.success) {
            classesList = res.data.data;
            populateClassSelects(classesList);
            if (classesList.length > 0) {
                tbody.innerHTML = classesList.map(c => `
                    <tr>
                        <td class="fw-bold">${c.displayOrder}</td>
                        <td class="fw-semibold text-body">${c.name}</td>
                        <td><span class="badge badge-saas-primary">${c.code}</span></td>
                        <td>${c.departmentName || '<span class="text-muted">General</span>'}</td>
                        <td>${c.capacity}</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">${c.sectionsCount} Sections</span></td>
                        <td><span class="badge bg-primary-subtle text-primary">${c.studentsCount} Students</span></td>
                        <td><span class="badge ${c.isActive ? 'badge-saas-success' : 'badge bg-danger'}">${c.isActive ? 'Active' : 'Inactive'}</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-link text-primary p-0 me-2" onclick="toggleStatus('classes', '${c.id}')" title="Toggle Active">
                                <i class="bi bi-toggle-${c.isActive ? 'on fs-5 text-success' : 'off fs-5 text-muted'}"></i>
                            </button>
                            <button class="btn btn-sm btn-link text-danger p-0" onclick="deleteItem('classes', '${c.id}')" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted">No classes created yet. Click "Add Class / Grade" to start.</td></tr>';
            }
        }
    }

    async function submitAddClass(e) {
        e.preventDefault();
        const body = {
            name: document.getElementById('clsName').value.trim(),
            code: document.getElementById('clsCode').value.trim(),
            displayOrder: parseInt(document.getElementById('clsOrder').value) || 0,
            capacity: parseInt(document.getElementById('clsCapacity').value) || 40,
            departmentId: document.getElementById('clsDepartment').value || null
        };
        const res = await App.apiFetch('/api/academics/classes', { method: 'POST', body: JSON.stringify(body) });
        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Success', 'Class / Grade created successfully.');
            bootstrap.Modal.getInstance(document.getElementById('modalAddClass')).hide();
            document.getElementById('formAddClass').reset();
            loadClasses();
        } else {
            App.showToast('error', 'Error', res.data?.message || 'Failed to create class.');
        }
    }

    // 2. DEPARTMENTS
    async function loadDepartments() {
        const res = await App.apiFetch('/api/academics/departments');
        const tbody = document.getElementById('tblDepartmentsBody');
        if (res.ok && res.data && res.data.success) {
            departmentsList = res.data.data;
            populateDeptSelects(departmentsList);
            if (departmentsList.length > 0) {
                tbody.innerHTML = departmentsList.map(d => `
                    <tr>
                        <td><span class="badge badge-saas-primary">${d.code}</span></td>
                        <td class="fw-semibold text-body">${d.name}</td>
                        <td class="small text-secondary">${d.description || '-'}</td>
                        <td>${d.headOfDepartmentName || '<span class="text-muted">Unassigned</span>'}</td>
                        <td>${d.totalStaff}</td>
                        <td>${d.totalCourses}</td>
                        <td><span class="badge ${d.isActive ? 'badge-saas-success' : 'badge bg-danger'}">${d.isActive ? 'Active' : 'Inactive'}</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-link text-primary p-0 me-2" onclick="toggleStatus('departments', '${d.id}')">
                                <i class="bi bi-toggle-${d.isActive ? 'on fs-5 text-success' : 'off fs-5 text-muted'}"></i>
                            </button>
                            <button class="btn btn-sm btn-link text-danger p-0" onclick="deleteItem('departments', '${d.id}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">No departments created yet.</td></tr>';
            }
        }
    }

    async function submitAddDept(e) {
        e.preventDefault();
        const body = {
            name: document.getElementById('deptName').value.trim(),
            code: document.getElementById('deptCode').value.trim(),
            description: document.getElementById('deptDesc').value.trim()
        };
        const res = await App.apiFetch('/api/academics/departments', { method: 'POST', body: JSON.stringify(body) });
        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Success', 'Department created successfully.');
            bootstrap.Modal.getInstance(document.getElementById('modalAddDept')).hide();
            document.getElementById('formAddDept').reset();
            loadDepartments();
        } else {
            App.showToast('error', 'Error', res.data?.message || 'Failed to create department.');
        }
    }

    // 3. SESSIONS
    async function loadSessions() {
        const res = await App.apiFetch('/api/academics/sessions');
        const tbody = document.getElementById('tblSessionsBody');
        if (res.ok && res.data && res.data.success) {
            const list = res.data.data;
            if (list.length > 0) {
                tbody.innerHTML = list.map(s => `
                    <tr>
                        <td class="fw-semibold text-body">${s.name}</td>
                        <td><span class="badge badge-saas-primary">${s.code}</span></td>
                        <td><span class="badge bg-secondary-subtle text-secondary">${s.type}</span></td>
                        <td class="small">${new Date(s.startDate).toLocaleDateString()}</td>
                        <td class="small">${new Date(s.endDate).toLocaleDateString()}</td>
                        <td><span class="badge ${s.isActive ? 'badge-saas-success' : 'badge bg-danger'}">${s.isActive ? 'Active' : 'Inactive'}</span></td>
                        <td>
                            ${s.isCurrent 
                                ? '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Current Active</span>' 
                                : `<button class="btn btn-sm btn-outline-secondary py-0" onclick="setCurrentSession('${s.id}')">Set Current</button>`}
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-link text-danger p-0" onclick="deleteItem('sessions', '${s.id}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">No academic sessions found.</td></tr>';
            }
        }
    }

    async function setCurrentSession(id) {
        const res = await App.apiFetch(`/api/academics/sessions/${id}/set-current`, { method: 'POST' });
        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Updated', 'Current academic session changed.');
            loadSessions();
        }
    }

    async function submitAddSession(e) {
        e.preventDefault();
        const body = {
            name: document.getElementById('sesName').value.trim(),
            code: document.getElementById('sesCode').value.trim(),
            type: document.getElementById('sesType').value,
            startDate: document.getElementById('sesStart').value,
            endDate: document.getElementById('sesEnd').value,
            isCurrent: document.getElementById('sesIsCurrent').checked
        };
        const res = await App.apiFetch('/api/academics/sessions', { method: 'POST', body: JSON.stringify(body) });
        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Success', 'Academic session created.');
            bootstrap.Modal.getInstance(document.getElementById('modalAddSession')).hide();
            document.getElementById('formAddSession').reset();
            loadSessions();
        } else {
            App.showToast('error', 'Error', res.data?.message || 'Failed to create session.');
        }
    }

    // 4. SUBJECTS
    async function loadSubjects() {
        const res = await App.apiFetch('/api/academics/subjects');
        const tbody = document.getElementById('tblSubjectsBody');
        if (res.ok && res.data && res.data.success) {
            subjectsList = res.data.data;
            populateSubjectSelect(subjectsList);
            if (subjectsList.length > 0) {
                tbody.innerHTML = subjectsList.map(s => `
                    <tr>
                        <td><span class="badge badge-saas-primary">${s.code}</span></td>
                        <td class="fw-semibold text-body">${s.name}</td>
                        <td>${s.departmentName || '<span class="text-muted">General</span>'}</td>
                        <td>${s.classGradeName || '<span class="text-muted">All Classes</span>'}</td>
                        <td>${s.creditHours} hrs</td>
                        <td><span class="badge bg-info-subtle text-info">${s.type}</span></td>
                        <td><span class="badge ${s.isActive ? 'badge-saas-success' : 'badge bg-danger'}">${s.isActive ? 'Active' : 'Inactive'}</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-link text-danger p-0" onclick="deleteItem('subjects', '${s.id}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">No subjects or courses added yet.</td></tr>';
            }
        }
    }

    async function submitAddSubject(e) {
        e.preventDefault();
        const body = {
            name: document.getElementById('subName').value.trim(),
            code: document.getElementById('subCode').value.trim(),
            creditHours: parseInt(document.getElementById('subCredits').value) || 3,
            type: document.getElementById('subType').value,
            departmentId: document.getElementById('subDept').value || null,
            classGradeId: document.getElementById('subClass').value || null
        };
        const res = await App.apiFetch('/api/academics/subjects', { method: 'POST', body: JSON.stringify(body) });
        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Success', 'Subject created.');
            bootstrap.Modal.getInstance(document.getElementById('modalAddSubject')).hide();
            document.getElementById('formAddSubject').reset();
            loadSubjects();
        } else {
            App.showToast('error', 'Error', res.data?.message || 'Failed to create subject.');
        }
    }

    // 5. ASSIGNMENTS
    async function loadAssignments() {
        const res = await App.apiFetch('/api/academics/assignments');
        const tbody = document.getElementById('tblAssignmentsBody');
        if (res.ok && res.data && res.data.success) {
            const list = res.data.data;
            if (list.length > 0) {
                tbody.innerHTML = list.map(a => `
                    <tr>
                        <td class="fw-semibold text-body">${a.classGradeName} &bull; ${a.classSectionName}</td>
                        <td><span class="badge badge-saas-primary me-1">${a.subjectCourseCode}</span> ${a.subjectCourseName}</td>
                        <td class="fw-medium"><i class="bi bi-person me-1 text-primary"></i> ${a.teacherName}</td>
                        <td>${a.academicSessionName || 'Current'}</td>
                        <td><span class="badge badge-saas-success">Assigned</span></td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-link text-danger p-0" onclick="deleteItem('assignments', '${a.id}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">No faculty course allocations recorded.</td></tr>';
            }
        }
    }

    async function submitAddAssignment(e) {
        e.preventDefault();
        const body = {
            classSectionId: document.getElementById('asgSection').value,
            subjectCourseId: document.getElementById('asgSubject').value,
            teacherUserId: document.getElementById('asgTeacher').value
        };
        const res = await App.apiFetch('/api/academics/assignments', { method: 'POST', body: JSON.stringify(body) });
        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Allocated', 'Teacher allocated to course section.');
            bootstrap.Modal.getInstance(document.getElementById('modalAddAssignment')).hide();
            loadAssignments();
        } else {
            App.showToast('error', 'Error', res.data?.message || 'Failed to allocate teacher.');
        }
    }

    // Helper functions
    async function loadTeachers() {
        const res = await App.apiFetch('/api/users?roleType=3&pageSize=100'); // 3 = Teacher
        if (res.ok && res.data && res.data.success) {
            teachersList = res.data.data.items;
            const sel = document.getElementById('asgTeacher');
            if (sel) {
                sel.innerHTML = '<option value="">Select Teacher...</option>' + 
                    teachersList.map(t => `<option value="${t.id}">${t.fullName} (${t.email})</option>`).join('');
            }
        }
    }

    function populateClassSelects(classes) {
        const subClass = document.getElementById('subClass');
        const asgSec = document.getElementById('asgSection');
        if (subClass) {
            subClass.innerHTML = '<option value="">All Classes / Common</option>' + 
                classes.map(c => `<option value="${c.id}">${c.name} (${c.code})</option>`).join('');
        }
        // Load sections for assignments
        loadSectionsForAssignments(classes);
    }

    async function loadSectionsForAssignments(classes) {
        const asgSec = document.getElementById('asgSection');
        if (!asgSec) return;
        asgSec.innerHTML = '<option value="">Select Section...</option>';
        for (const c of classes) {
            const res = await App.apiFetch(`/api/academics/classes/${c.id}/sections`);
            if (res.ok && res.data && res.data.success) {
                const secs = res.data.data;
                secs.forEach(s => {
                    asgSec.innerHTML += `<option value="${s.id}">${c.name} &bull; ${s.name}</option>`;
                });
            }
        }
    }

    function populateDeptSelects(depts) {
        const clsDept = document.getElementById('clsDepartment');
        const subDept = document.getElementById('subDept');
        const opts = '<option value="">None / General</option>' + 
            depts.map(d => `<option value="${d.id}">${d.name} (${d.code})</option>`).join('');
        if (clsDept) clsDept.innerHTML = opts;
        if (subDept) subDept.innerHTML = opts;
    }

    function populateSubjectSelect(subjects) {
        const asgSub = document.getElementById('asgSubject');
        if (asgSub) {
            asgSub.innerHTML = '<option value="">Select Subject / Course...</option>' + 
                subjects.map(s => `<option value="${s.id}">${s.code} - ${s.name}</option>`).join('');
        }
    }

    async function toggleStatus(type, id) {
        const res = await App.apiFetch(`/api/academics/${type}/${id}/toggle-status`, { method: 'PATCH' });
        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Updated', 'Status changed.');
            refreshCurrentTab();
        }
    }

    async function deleteItem(type, id) {
        if (!confirm('Are you sure you want to remove this academic item?')) return;
        const res = await App.apiFetch(`/api/academics/${type}/${id}`, { method: 'DELETE' });
        if (res.ok && res.data && res.data.success) {
            App.showToast('success', 'Removed', 'Item deleted.');
            refreshCurrentTab();
        } else {
            App.showToast('error', 'Error', res.data?.message || 'Failed to delete item.');
        }
    }
</script>
}
