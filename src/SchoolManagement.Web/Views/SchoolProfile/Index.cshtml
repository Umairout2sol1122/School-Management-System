@{
    ViewData["Title"] = "School Profile & Campus Settings";
}

<div class="row g-4">
    <!-- Top Banner Card -->
    <div class="col-12">
        <div class="card p-4 border-0 shadow-sm" style="background: linear-gradient(135deg, rgba(146, 78, 192, 0.08) 0%, rgba(146, 78, 192, 0.02) 100%); border-left: 4px solid var(--saas-primary) !important;">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div id="schoolLogoContainer" class="rounded-3 d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" 
                         style="width: 72px; height: 72px; background: var(--saas-primary-gradient); font-size: 1.75rem;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h3 class="fw-bold mb-0 text-body" id="lblSchoolName">Loading School Profile...</h3>
                            <span class="badge badge-saas-primary" id="lblSchoolCode">CODE</span>
                            <span class="badge badge-saas-success" id="lblSchoolStatus">Active Institution</span>
                        </div>
                        <p class="text-secondary small mb-0 mt-1" id="lblSchoolSubtext">
                            <i class="bi bi-geo-alt me-1"></i> <span id="lblSchoolAddress">Campus Location</span> &bull; 
                            <i class="bi bi-envelope me-1 ms-2"></i> <span id="lblSchoolEmail">contact@school.edu</span>
                        </p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-saas-outline" onclick="loadSchoolProfile()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                    </button>
                    <button class="btn btn-saas-primary" id="btnEditProfile" onclick="openEditModal()" data-roles="OrganizationAdmin,Principal,SuperAdmin">
                        <i class="bi bi-pencil-square me-1"></i> Edit Profile & Branding
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Profile Details -->
    <div class="col-lg-8">
        <div class="card p-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-primary"></i> General Institution Details
            </h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label text-secondary small fw-medium">Official Name</label>
                    <div class="fw-semibold text-body fs-6" id="dispSchoolName">-</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-secondary small fw-medium">Institutional Code</label>
                    <div class="fw-semibold text-body fs-6" id="dispSchoolCode">-</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-secondary small fw-medium">Primary Contact Email</label>
                    <div class="fw-semibold text-body fs-6" id="dispSchoolEmail">-</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-secondary small fw-medium">Official Phone / Helpline</label>
                    <div class="fw-semibold text-body fs-6" id="dispSchoolPhone">-</div>
                </div>
                <div class="col-12">
                    <label class="form-label text-secondary small fw-medium">Campus Physical Address</label>
                    <div class="fw-semibold text-body fs-6" id="dispSchoolAddress">-</div>
                </div>
            </div>

            <hr class="my-4">

            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-palette text-primary"></i> Visual Identity & Brand Styling
            </h5>
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3">
                        <div id="dispPrimaryColorBox" class="rounded-3 shadow-sm" style="width: 44px; height: 44px; background: #924EC0; border: 2px solid var(--saas-border);"></div>
                        <div>
                            <div class="small text-secondary">Primary Brand Color</div>
                            <div class="fw-bold" id="dispPrimaryColorText">#924EC0</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3">
                        <div id="dispSecondaryColorBox" class="rounded-3 shadow-sm" style="width: 44px; height: 44px; background: #5840BA; border: 2px solid var(--saas-border);"></div>
                        <div>
                            <div class="small text-secondary">Secondary Accent Color</div>
                            <div class="fw-bold" id="dispSecondaryColorText">#5840BA</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats & Campuses Overview -->
    <div class="col-lg-4">
        <div class="card p-4 mb-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-buildings text-primary"></i> Institution Scope
            </h5>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: var(--saas-surface);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle p-2" style="background: rgba(146, 78, 192, 0.1); color: var(--saas-primary);">
                            <i class="bi bi-building fs-5"></i>
                        </div>
                        <div>
                            <div class="small text-secondary">Active Campuses</div>
                            <div class="fw-bold fs-5" id="dispBranchCount">0</div>
                        </div>
                    </div>
                    <span class="badge badge-saas-primary">Branches</span>
                </div>
                <a href="/branches" class="btn btn-sm btn-saas-secondary w-100" data-roles="OrganizationAdmin,Principal">
                    <i class="bi bi-buildings me-1"></i> Manage Campuses &amp; Branches
                </a>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: var(--saas-surface);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle p-2" style="background: rgba(16, 185, 129, 0.1); color: var(--saas-success);">
                            <i class="bi bi-people fs-5"></i>
                        </div>
                        <div>
                            <div class="small text-secondary">Authorized Accounts</div>
                            <div class="fw-bold fs-5" id="dispUserCount">0</div>
                        </div>
                    </div>
                    <span class="badge badge-saas-success">Users</span>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: var(--saas-surface);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle p-2" style="background: rgba(59, 130, 246, 0.1); color: var(--saas-info);">
                            <i class="bi bi-shield-check fs-5"></i>
                        </div>
                        <div>
                            <div class="small text-secondary">System Edition</div>
                            <div class="fw-bold fs-6">Enterprise Cloud</div>
                        </div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">v2026.1</span>
                </div>
            </div>
        </div>

        <div class="card p-4">
            <h6 class="fw-bold mb-2">School Management API</h6>
            <p class="text-secondary small mb-3">All institution operations are synchronized across Web & Desktop/Mobile MAUI clients.</p>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-saas-success"><i class="bi bi-link-45deg me-1"></i> Connected</span>
                <span class="text-secondary small">Port: 7011</span>
            </div>
        </div>
    </div>
</div>

<!-- Edit School Profile Modal -->
<div class="modal fade" id="modalEditSchoolProfile" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-pencil-square text-primary me-2"></i> Update School Profile & Branding
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formEditProfile" onsubmit="handleUpdateProfile(event)">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label required">School Name</label>
                            <input type="text" class="form-control" id="editSchoolName" required placeholder="e.g. Apex International Grammar School">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Official Email</label>
                            <input type="email" class="form-control" id="editSchoolEmail" placeholder="principal@school.edu.pk">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Helpline / Phone</label>
                            <input type="text" class="form-control" id="editSchoolPhone" placeholder="+92 300 1234567">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Physical Campus Address</label>
                            <textarea class="form-control" id="editSchoolAddress" rows="2" placeholder="Sector F-8/3, Islamabad, Pakistan"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Primary Brand Color</label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" id="editPrimaryColor" value="#924EC0" title="Choose brand color">
                                <input type="text" class="form-control" id="editPrimaryColorHex" value="#924EC0" maxlength="7">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Secondary Brand Color</label>
                            <div class="input-group">
                                <input type="color" class="form-control form-control-color" id="editSecondaryColor" value="#5840BA" title="Choose secondary color">
                                <input type="text" class="form-control" id="editSecondaryColorHex" value="#5840BA" maxlength="7">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-saas-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-saas-primary" id="btnSaveProfile">
                        <span class="spinner-border spinner-border-sm me-2 d-none" id="saveSpinner"></span>
                        <i class="bi bi-check2-circle me-1" id="saveIcon"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentProfile = null;
    let editModal = null;

    document.addEventListener("DOMContentLoaded", () => {
        if (!App.isAuthenticated()) {
            window.location.href = "/login";
            return;
        }
        if (!App.hasRole('OrganizationAdmin', 'Principal', 'SuperAdmin')) {
            App.showToast('error', 'Access Denied', 'School Profile settings are restricted to Institution Administrators.');
            setTimeout(() => { window.location.href = "/"; }, 800);
            return;
        }
        editModal = new bootstrap.Modal(document.getElementById("modalEditSchoolProfile"));
        loadSchoolProfile();

        // Sync color picker and hex text
        const pColor = document.getElementById("editPrimaryColor");
        const pHex = document.getElementById("editPrimaryColorHex");
        pColor.addEventListener("input", (e) => pHex.value = e.target.value);
        pHex.addEventListener("input", (e) => pColor.value = e.target.value);

        const sColor = document.getElementById("editSecondaryColor");
        const sHex = document.getElementById("editSecondaryColorHex");
        sColor.addEventListener("input", (e) => sHex.value = e.target.value);
        sHex.addEventListener("input", (e) => sColor.value = e.target.value);
    });

    async function loadSchoolProfile() {
        const res = await apiFetch("/api/organizations/my-school");
        if (res.ok && res.data && res.data.success) {
            currentProfile = res.data.data;
            renderSchoolProfile(currentProfile);
        } else {
            showToast("Failed to load school profile: " + (res.data?.message || "Check connection"), "danger");
        }
    }

    function renderSchoolProfile(p) {
        document.getElementById("lblSchoolName").textContent = p.name || "School Name";
        document.getElementById("lblSchoolCode").textContent = p.code || "CODE";
        document.getElementById("lblSchoolStatus").textContent = p.isActive ? "Active Institution" : "Suspended";
        document.getElementById("lblSchoolStatus").className = p.isActive ? "badge badge-saas-success" : "badge bg-danger";
        document.getElementById("lblSchoolAddress").textContent = p.address || "Address not configured";
        document.getElementById("lblSchoolEmail").textContent = p.email || "No email specified";

        document.getElementById("dispSchoolName").textContent = p.name || "-";
        document.getElementById("dispSchoolCode").textContent = p.code || "-";
        document.getElementById("dispSchoolEmail").textContent = p.email || "-";
        document.getElementById("dispSchoolPhone").textContent = p.phone || "-";
        document.getElementById("dispSchoolAddress").textContent = p.address || "-";

        const primaryCol = p.themePrimaryColor || "#924EC0";
        const secCol = p.themeSecondaryColor || "#5840BA";

        document.getElementById("dispPrimaryColorBox").style.background = primaryCol;
        document.getElementById("dispPrimaryColorText").textContent = primaryCol;
        document.getElementById("dispSecondaryColorBox").style.background = secCol;
        document.getElementById("dispSecondaryColorText").textContent = secCol;

        document.getElementById("dispBranchCount").textContent = p.branchesCount || 0;
        document.getElementById("dispUserCount").textContent = p.usersCount || 0;
    }

    function openEditModal() {
        if (!currentProfile) return;
        document.getElementById("editSchoolName").value = currentProfile.name || "";
        document.getElementById("editSchoolEmail").value = currentProfile.email || "";
        document.getElementById("editSchoolPhone").value = currentProfile.phone || "";
        document.getElementById("editSchoolAddress").value = currentProfile.address || "";

        const prim = currentProfile.themePrimaryColor || "#924EC0";
        const sec = currentProfile.themeSecondaryColor || "#5840BA";
        document.getElementById("editPrimaryColor").value = prim;
        document.getElementById("editPrimaryColorHex").value = prim;
        document.getElementById("editSecondaryColor").value = sec;
        document.getElementById("editSecondaryColorHex").value = sec;

        editModal.show();
    }

    async function handleUpdateProfile(e) {
        e.preventDefault();
        const btn = document.getElementById("btnSaveProfile");
        const spin = document.getElementById("saveSpinner");
        const icon = document.getElementById("saveIcon");

        btn.disabled = true;
        spin.classList.remove("d-none");
        icon.classList.add("d-none");

        const body = {
            name: document.getElementById("editSchoolName").value.trim(),
            email: document.getElementById("editSchoolEmail").value.trim(),
            phone: document.getElementById("editSchoolPhone").value.trim(),
            address: document.getElementById("editSchoolAddress").value.trim(),
            themePrimaryColor: document.getElementById("editPrimaryColorHex").value.trim(),
            themeSecondaryColor: document.getElementById("editSecondaryColorHex").value.trim(),
            themeDarkMode: false
        };

        const res = await apiFetch("/api/organizations/my-school", {
            method: "PUT",
            body: JSON.stringify(body)
        });

        btn.disabled = false;
        spin.classList.add("d-none");
        icon.classList.remove("d-none");

        if (res.ok && res.data && res.data.success) {
            showToast("School profile updated successfully!", "success");
            currentProfile = res.data.data;
            renderSchoolProfile(currentProfile);
            editModal.hide();
        } else {
            showToast("Failed to update profile: " + (res.data?.message || "Unknown error"), "danger");
        }
    }
</script>
}
